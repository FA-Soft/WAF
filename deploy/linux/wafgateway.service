# WAF Gateway: reverse proxy with a web application firewall.
# Installed by install.sh as /etc/systemd/system/wafgateway.service (@PREFIX@ is replaced by the program folder).
# Local changes belong in a drop-in (systemctl edit wafgateway), so an upgrade does not overwrite them.

[Unit]
Description=WAF Gateway (reverse proxy with a web application firewall)
Documentation=https://github.com/FA-Soft/WAF#installation
After=network-online.target
Wants=network-online.target

[Service]
# The gateway tells systemd when its listeners are up (and when it stops).
Type=notify
ExecStart=@PREFIX@/WafGateway
WorkingDirectory=@PREFIX@
User=wafgateway
Group=wafgateway
Environment=DOTNET_ENVIRONMENT=Production ASPNETCORE_ENVIRONMENT=Production DOTNET_CLI_TELEMETRY_OPTOUT=1
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
LimitNOFILE=65536
UMask=0027

# Data (/var/lib/wafgateway) and configuration (/etc/wafgateway): created and owned by systemd for this service.
# The data folder is the only place the gateway can write to; the configuration folder is read-only for it.
StateDirectory=wafgateway
StateDirectoryMode=0750
ConfigurationDirectory=wafgateway
ConfigurationDirectoryMode=0750

# Ports 80 and 443 without root: this one capability, and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# File system: everything read-only except the data folder; no home folders, a private /tmp, no devices.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true

# Kernel and system: no tuning, modules, logs, clock, hostname or control groups; other processes invisible.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
KeyringMode=private
RemoveIPC=true

# Processes and system calls.
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Network: IPv4, IPv6, local sockets and netlink (used by .NET to list network interfaces).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# Not set: MemoryDenyWriteExecute (the .NET JIT compiler needs writable executable memory) and PrivateUsers
# (a user namespace would take away the capability to bind ports 80 and 443).

[Install]
WantedBy=multi-user.target
