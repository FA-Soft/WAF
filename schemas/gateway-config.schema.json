{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WAF Gateway configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "SchemaVersion": {
      "type": "integer"
    },
    "Settings": {
      "type": "object",
      "properties": {
        "DetectionOnly": {
          "type": "boolean"
        },
        "TrustedProxies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "Acme": {
          "type": "object",
          "properties": {
            "Email": {
              "type": [
                "string",
                "null"
              ]
            },
            "AcceptTermsOfService": {
              "type": "boolean"
            },
            "UseStaging": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "AttackDetection": {
          "type": "object",
          "properties": {
            "Enabled": {
              "type": "boolean"
            },
            "SqlInjection": {
              "type": "boolean"
            },
            "CrossSiteScripting": {
              "type": "boolean"
            },
            "PathTraversal": {
              "type": "boolean"
            },
            "CommandInjection": {
              "type": "boolean"
            },
            "BadUserAgents": {
              "type": "boolean"
            },
            "InspectBody": {
              "type": "boolean"
            },
            "MaxBodyBytes": {
              "type": "integer"
            },
            "Exclusions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "PathPrefix": {
                    "type": "string"
                  },
                  "Routes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "Categories": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "SqlInjection",
                        "CrossSiteScripting",
                        "PathTraversal",
                        "CommandInjection",
                        "BadUserAgent"
                      ]
                    }
                  },
                  "Reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "LogRetention": {
          "type": "object",
          "properties": {
            "MaxAgeDays": {
              "type": "integer"
            },
            "MaxDatabaseSizeMb": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "RateLimitMaxTrackedClients": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "Routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Enabled": {
            "type": "boolean"
          },
          "Match": {
            "type": "object",
            "properties": {
              "Hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "PathPrefix": {
                "type": "string"
              },
              "Methods": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "Destinations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Scheme": {
                  "type": "string"
                },
                "Address": {
                  "type": "string"
                },
                "Port": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            }
          },
          "PreserveHost": {
            "type": "boolean"
          },
          "AllowInvalidBackendCertificate": {
            "type": "boolean"
          },
          "HealthCheck": {
            "type": "object",
            "properties": {
              "Path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "IntervalSeconds": {
                "type": "integer"
              },
              "TimeoutSeconds": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "Rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Description": {
            "type": [
              "string",
              "null"
            ]
          },
          "Enabled": {
            "type": "boolean"
          },
          "Priority": {
            "type": "integer"
          },
          "Action": {
            "enum": [
              "Allow",
              "Block",
              "LogOnly"
            ]
          },
          "DetectionOnly": {
            "type": "boolean"
          },
          "Routes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Field": {
                  "enum": [
                    "ClientIp",
                    "Host",
                    "Path",
                    "QueryString",
                    "Method",
                    "Header",
                    "UserAgent"
                  ]
                },
                "HeaderName": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "Operator": {
                  "enum": [
                    "Equals",
                    "StartsWith",
                    "EndsWith",
                    "Contains",
                    "Regex",
                    "InCidr"
                  ]
                },
                "Values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "CaseSensitive": {
                  "type": "boolean"
                },
                "Negate": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "RateLimits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Description": {
            "type": [
              "string",
              "null"
            ]
          },
          "Enabled": {
            "type": "boolean"
          },
          "PermitLimit": {
            "type": "integer"
          },
          "WindowSeconds": {
            "type": "integer"
          },
          "Key": {
            "enum": [
              "ClientIp",
              "ClientIpAndRoute",
              "Route"
            ]
          },
          "DetectionOnly": {
            "type": "boolean"
          },
          "Routes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Conditions": {
            "type": "array",
            "items": {
              "$ref": "#/properties/Rules/items/properties/Conditions/items"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "Certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "HostName": {
            "type": "string"
          },
          "Source": {
            "enum": [
              "LetsEncrypt",
              "File"
            ]
          },
          "CertificatePath": {
            "type": [
              "string",
              "null"
            ]
          },
          "KeyPath": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
