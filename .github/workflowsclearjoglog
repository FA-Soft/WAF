name: Cleanup Old Workflow Runs

on:
  workflow_dispatch:
    inputs:
      retention_days:
        description: "Delete workflow runs older than this many days"
        required: true
        default: "90"
        type: string

permissions:
  actions: write

jobs:
  cleanup:
    runs-on: ubuntu-latest

    steps:
      - name: Delete old workflow runs
        env:
          GH_TOKEN: ${{ github.token }}
          RETENTION_DAYS: ${{ inputs.retention_days }}
        run: |
          cutoff=$(date -u -d "$RETENTION_DAYS days ago" +%s)

          gh api \
            repos/${{ github.repository }}/actions/runs \
            --paginate \
            --jq '.workflow_runs[] | [.id, .created_at] | @tsv' |
          while IFS=$'\t' read -r run_id created_at
          do
            created_ts=$(date -u -d "$created_at" +%s)

            if [ "$created_ts" -lt "$cutoff" ]; then
              echo "Deleting run $run_id ($created_at)"
              gh api \
                -X DELETE \
                repos/${{ github.repository }}/actions/runs/$run_id
            fi
          done
