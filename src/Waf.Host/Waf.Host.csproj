<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>Gateway host: startup, Kestrel and service hosting.</Description>
    <AssemblyName>WafGateway</AssemblyName>
    <!-- Icon of WafGateway.exe (Explorer, Task Manager). Drawn from docs/brand/waf-icon.svg. -->
    <ApplicationIcon>../../docs/brand/waf-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Blazor framework script (_framework/blazor.web.js) as a static web asset for the admin UI. -->
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Waf.Core/Waf.Core.csproj" />
    <ProjectReference Include="../Waf.Engine/Waf.Engine.csproj" />
    <ProjectReference Include="../Waf.Proxy/Waf.Proxy.csproj" />
    <ProjectReference Include="../Waf.Data/Waf.Data.csproj" />
    <ProjectReference Include="../Waf.Ai/Waf.Ai.csproj" />
    <ProjectReference Include="../Waf.Web/Waf.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Waf.IntegrationTests" />
    <InternalsVisibleTo Include="Waf.UnitTests" />
  </ItemGroup>

</Project>
