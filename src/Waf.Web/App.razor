<!DOCTYPE html>
@* data-theme: the theme the admin chose (stored with the account); without it the stylesheet follows the system setting. *@
@* lang: the language of the UI for this request (AdminLanguage). *@
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="@AdminTheme.DataAttribute(HttpContext?.User)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="@Assets["_content/Waf.Web/favicon.svg"]" />
    <link rel="stylesheet" href="@Assets["_content/Waf.Web/admin.css"]" />
    <HeadOutlet />
</head>
<body>
    <a class="skip-link" href="#main">@T("Skip to content")</a>
    <Routes />
    @* Enhanced navigation and forms; no inline scripts, so a strict Content-Security-Policy applies. *@
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    @* Live view of the request log; does nothing on other pages. *@
    <script src="@Assets["_content/Waf.Web/logs.js"]"></script>
    @* Live traffic on the dashboard (SignalR client served from the gateway itself); does nothing on other pages. *@
    <script src="@Assets["_content/Waf.Web/lib/signalr/signalr.min.js"]"></script>
    <script src="@Assets["_content/Waf.Web/live.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }
}
