@*
    Inline help: a small "?" that opens an explanation in place. Built on <details>/<summary>, so it works
    without JavaScript and with the keyboard (Enter/Space) and screen readers.
*@
<details class="help">
    <summary aria-label="@($"Help: {Title}")" title="@($"Help: {Title}")"><span aria-hidden="true">?</span></summary>
    <div class="help-body">
        <strong>@Title</strong>
        @ChildContent
    </div>
</details>

@code {
    /// <summary>What the help is about (also the accessible name of the toggle).</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>The explanation, in plain language.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
