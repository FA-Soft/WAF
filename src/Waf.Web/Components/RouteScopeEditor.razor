@* Route checkboxes for rules and rate limits. None ticked: all requests, including ones that match no route. *@
@using System.Globalization

<div class="field" role="group" aria-labelledby="scope-label" aria-describedby="scope-help">
    <span class="label" id="scope-label">Only for these routes <span class="field-optional">(optional)</span></span>
    <p class="field-help" id="scope-help">None ticked: every request, also requests that match no route.</p>
    @if (Choices.Count == 0)
    {
        <p class="muted">There are no routes yet.</p>
    }
    else
    {
        <div class="checkbox-row">
            @for (var i = 0; i < Choices.Count; i++)
            {
                var choice = Choices[i];
                var name = $"{Prefix}.RouteChoices[{i.ToString(CultureInfo.InvariantCulture)}]";
                <input type="hidden" name="@($"{name}.Name")" value="@choice.Name" />
                <label><input type="checkbox" name="@($"{name}.Selected")" value="true" checked="@choice.Selected" /> @choice.Name</label>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Prefix { get; set; } = "Model";

    [Parameter, EditorRequired]
    public List<RouteChoice> Choices { get; set; } = [];
}
