@* Shown above an editor that was opened from the template library. *@
@if (!string.IsNullOrEmpty(Title))
{
    <div class="alert alert-info" role="status">
        <strong>@T("Started from the template \"{0}\".", T(Title))</strong>
        @T("Check every field and replace the example values with your own: nothing is saved until you press the button at the bottom.")
        <a href="library">@T("Other templates")</a>
    </div>
}

@code {
    /// <summary>The template's title; nothing is shown when null (no or an unknown template).</summary>
    [Parameter]
    public string? Title { get; set; }
}
