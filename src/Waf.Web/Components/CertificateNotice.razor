@* A warning on the dashboard while a host name's certificate is expiring, expired, missing or wrong. *@
@inject ICertificateManager Manager
@inject TimeProvider Time

@if (_problems.Count > 0)
{
    var danger = _problems.Any(p => p.State != CertificateState.ExpiresSoon);
    <div class="alert @(danger ? "alert-danger" : "alert-warning")" role="status">
        <strong>@Plural(_problems.Count, "{0} certificate needs attention.", "{0} certificates need attention.")</strong>
        <ul>
            @foreach (var problem in _problems)
            {
                <li>@problem.HostName: @Describe(problem)</li>
            }
        </ul>
        <a href="certificates">@T("Manage certificates")</a>
    </div>
}

@code {
    private IReadOnlyList<CertificateStatus> _problems = [];

    protected override void OnInitialized() =>
        _problems = [.. Manager.Statuses.Where(s => s.NeedsAttention).OrderBy(s => s.HostName, StringComparer.OrdinalIgnoreCase)];

    private static string Day(DateTime? day) => day?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "?";

    private string Describe(CertificateStatus status) => status.State switch
    {
        CertificateState.ExpiresSoon => Plural(status.DaysLeft(Time.GetUtcNow().UtcDateTime) ?? 0, "expires in {0} day.", "expires in {0} days.")
            + " " + T("Valid until {0}.", Day(status.NotAfterUtc)),
        CertificateState.Expired => T("expired on {0}; browsers refuse it.", Day(status.NotAfterUtc)),
        CertificateState.Missing => T("no certificate could be loaded; HTTPS connections for it are refused."),
        CertificateState.WrongHost => T("the certificate is for another host name; browsers refuse it."),
        _ => Message(status.Problem ?? status.State.ToString()),
    };
}
