@* Shown above an editor that was opened from a request log entry. *@
@if (Entry is not null)
{
    <div class="alert alert-info" role="status">
        <strong>@T("Pre-filled from") <a href="@($"logs/{Entry.Id}")">@T("request {0}", Entry.Id)</a>:</strong>
        @(Entry.RuleName is null
            ? T("{0} {1}{2} from {3}.", Entry.Method, Entry.Host, Entry.Path, Entry.ClientIp)
            : T("{0} {1}{2} from {3} ({4}).", Entry.Method, Entry.Host, Entry.Path, Entry.ClientIp, Entry.RuleName))
        @if (Message is not null)
        {
            <span>@Message</span>
        }
        @T("Check the form; nothing changes until you save.")
    </div>
}
else if (Missing)
{
    <div class="alert alert-warning" role="status">@T("The log entry no longer exists; the form is not pre-filled.")</div>
}

@code {
    /// <summary>The entry the form was filled from; null when none.</summary>
    [Parameter]
    public RequestEvent? Entry { get; set; }

    /// <summary>True when a log entry was asked for but not found.</summary>
    [Parameter]
    public bool Missing { get; set; }

    /// <summary>An extra sentence, e.g. "203.0.113.7 was added to the list below."</summary>
    [Parameter]
    public string? Message { get; set; }
}
