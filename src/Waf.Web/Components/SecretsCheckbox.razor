@* The "include secrets" choice of the export and backup forms (plain HTML forms posting to a download endpoint). *@

<div class="field checkbox-field">
    <input type="checkbox" id="@Id" name="includeSecrets" value="true" aria-describedby="@($"{Id}-help")" />
    <label for="@Id">@T("Include secrets")</label>
    <p class="field-help" id="@($"{Id}-help")">
        @if (Count == 0)
        {
            <span>@T("The configuration has no secret values at the moment.")</span>
        }
        else
        {
            <span>@Plural(Count, "{0} secret value (header conditions, such as API keys).", "{0} secret values (header conditions, such as API keys).") @T("Without this option they are replaced by \"{0}\"; importing the file here keeps the current values. Only include them when you store the file safely.", ConfigurationSecrets.Placeholder)</span>
        }
        @if (Certificates > 0)
        {
            <span> @Plural(Certificates, "The {0} uploaded certificate, with its private key, is only included with this option.", "The {0} uploaded certificates, with their private keys, are only included with this option.")</span>
        }
    </p>
</div>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    /// <summary>Number of secret values in the configuration.</summary>
    [Parameter]
    public int Count { get; set; }

    /// <summary>Number of uploaded certificates (only for the full backup).</summary>
    [Parameter]
    public int Certificates { get; set; }
}
