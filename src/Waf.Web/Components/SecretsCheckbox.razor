@* The "include secrets" choice of the export and backup forms (plain HTML forms posting to a download endpoint). *@

<div class="field checkbox-field">
    <input type="checkbox" id="@Id" name="includeSecrets" value="true" aria-describedby="@($"{Id}-help")" />
    <label for="@Id">Include secrets</label>
    <p class="field-help" id="@($"{Id}-help")">
        @if (Count == 0)
        {
            <span>The configuration has no secret values at the moment.</span>
        }
        else
        {
            <span>@Count secret value@(Count == 1 ? "" : "s") (header conditions, such as API keys). Without this option they are replaced by "@ConfigurationSecrets.Placeholder"; importing the file here keeps the current values. Only include them when you store the file safely.</span>
        }
        @if (Certificates > 0)
        {
            <span> The @Certificates uploaded certificate@(Certificates == 1 ? "" : "s"), with private key@(Certificates == 1 ? "" : "s"), @(Certificates == 1 ? "is" : "are") only included with this option.</span>
        }
    </p>
</div>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    /// <summary>Number of secret values in the configuration.</summary>
    [Parameter]
    public int Count { get; set; }

    /// <summary>Number of uploaded certificates (only for the full backup).</summary>
    [Parameter]
    public int Certificates { get; set; }
}
