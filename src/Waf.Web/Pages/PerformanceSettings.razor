@page "/performance/settings"
@using System.ComponentModel.DataAnnotations
@inject IGatewayConfigurationService Configurations
@inject NavigationManager Navigation

<PageTitle>@T("Notice settings") · @ProductInfo.Name</PageTitle>

<p><a href="performance">← @T("Performance")</a></p>
<h1>@T("Notice settings")</h1>
<p>@T("When total, bad or failed traffic is far above the usual level for that hour of the week, a notice shows on the dashboard and the Performance page, and goes to the service log.")</p>

@if (!string.IsNullOrEmpty(Saved))
{
    <div class="alert alert-ok" role="status">@Message(Saved)</div>
}

@if (_errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <strong>@T("The settings were not saved.")</strong> @T("The running configuration is unchanged.")
        <ul>
            @foreach (var error in _errors)
            {
                <li>@Message(error)</li>
            }
        </ul>
    </div>
}

@if (Model is not null)
{
    <EditForm Model="Model" FormName="traffic-alerts" OnValidSubmit="SaveAsync" Enhance class="form">
        <DataAnnotationsValidator />
        <ValidationList Class="alert alert-danger validation-summary" />
        <input type="hidden" name="Model.BaseVersion" value="@Model.BaseVersion" />
        <fieldset>
            <legend>@T("Notices of unusual traffic")</legend>
            <div class="field field-check">
                <label><InputCheckbox @bind-Value="Model.Enabled" /> @T("Notice unusual traffic")</label>
            </div>
            <FormField Id="sensitivity" Label="@T("Times the usual level")" Help="@T("A notice starts when traffic reaches this many times its usual level for that hour of the week (2 to 100). Lower notices more; higher only big spikes.")" For="() => Model.Sensitivity">
                <InputNumber id="sensitivity" aria-describedby="sensitivity-help" @bind-Value="Model.Sensitivity" min="@TrafficAlertSettings.MinSensitivity" max="@TrafficAlertSettings.MaxSensitivity" step="0.5" />
            </FormField>
            <FormField Id="minimum" Label="@T("At least (requests per minute)")" Help="@T("No notice below this many requests a minute, so a quiet site does not get notices about a handful of requests.")" For="() => Model.MinimumPerMinute">
                <InputNumber id="minimum" aria-describedby="minimum-help" @bind-Value="Model.MinimumPerMinute" min="1" max="@TrafficAlertSettings.MaxMinimumPerMinute" />
            </FormField>
        </fieldset>
        <div class="actions">
            <button type="submit" class="button">@T("Save")</button>
        </div>
        <p class="muted">@T("Saving creates a new configuration version. The next check (within 15 seconds) uses the new settings.")</p>
    </EditForm>
}

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private IReadOnlyList<string> _errors = [];

    [SupplyParameterFromQuery]
    public string? Saved { get; set; }

    [SupplyParameterFromForm(FormName = "traffic-alerts")]
    private TrafficAlertFormModel? Model { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var active = await Configurations.GetActiveAsync(CancellationToken.None);
        var settings = active?.Configuration.Settings.TrafficAlerts ?? new TrafficAlertSettings();
        Model ??= new TrafficAlertFormModel
        {
            BaseVersion = active?.Version ?? 0,
            Enabled = settings.Enabled,
            Sensitivity = settings.Sensitivity,
            MinimumPerMinute = settings.MinimumPerMinute,
        };
    }

    private async Task SaveAsync()
    {
        var model = Model!;
        var active = await Configurations.GetActiveAsync(CancellationToken.None);
        var configuration = ConfigurationEditing.Clone(active!.Configuration);
        configuration.Settings.TrafficAlerts.Enabled = model.Enabled;
        configuration.Settings.TrafficAlerts.Sensitivity = model.Sensitivity;
        configuration.Settings.TrafficAlerts.MinimumPerMinute = model.MinimumPerMinute;

        var result = await Configurations.ActivateIfCurrentAsync(model.BaseVersion, configuration, AdminActor.From(HttpContext), "Notice settings changed.", CancellationToken.None);
        if (!result.Succeeded)
        {
            _errors = result.Errors;
            return;
        }

        Navigation.NavigateTo($"performance/settings?saved={Uri.EscapeDataString($"Notice settings saved (version {result.Version!.Version}).")}");
    }

    /// <summary>Form model of the notice settings.</summary>
    private sealed class TrafficAlertFormModel
    {
        public long BaseVersion { get; set; }

        public bool Enabled { get; set; }

        [Range(TrafficAlertSettings.MinSensitivity, TrafficAlertSettings.MaxSensitivity, ErrorMessage = "Use 2 to 100 times the usual level.")]
        public double Sensitivity { get; set; }

        [Range(1, TrafficAlertSettings.MaxMinimumPerMinute, ErrorMessage = "Use at least 1 request per minute.")]
        public int MinimumPerMinute { get; set; }
    }
}
