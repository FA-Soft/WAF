@page "/audit"
@inject AuditLogStore AuditLog

<PageTitle>Audit log · @ProductInfo.Name</PageTitle>

<h1>
    Audit log
    <HelpTip Title="Audit log">
        <p>Who changed what, and when: every configuration version, sign-ins and sign-outs, changes to passwords and two-factor sign-in, backups, downloads and log cleanups. Entries are never changed or removed. Times are in UTC.</p>
        <p>Every configuration version has an entry here, with the routes, rules and settings it changed. Single failed sign-in attempts are in the <a href="account/history">login history</a>.</p>
    </HelpTip>
</h1>

<form method="get" action="audit" class="log-filter" role="search" aria-label="Filter the audit log">
    <div class="field-row">
        <div class="field">
            <label for="category">What</label>
            <select id="category" name="category">
                <option value="" selected="@(_category is null)">Everything</option>
                @foreach (var (value, label) in Categories)
                {
                    <option value="@value" selected="@(value == _category)">@label</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="user">Who</label>
            <select id="user" name="user">
                <option value="" selected="@(_user is null)">Anyone</option>
                @foreach (var name in _users)
                {
                    <option value="@name" selected="@(string.Equals(name, _user, StringComparison.OrdinalIgnoreCase))">@name</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="version">Configuration version</label>
            <input id="version" name="version" type="number" min="1" value="@_version" />
        </div>
    </div>
    <div class="actions">
        <button type="submit" class="button">Apply</button>
        @if (IsFiltered)
        {
            <a class="button button-secondary" href="audit">Clear filters</a>
        }
    </div>
</form>

@if (_page.Items.Count == 0)
{
    <p class="muted">@(IsFiltered ? "No entries match the filter." : "Nothing recorded yet.")</p>
}
else
{
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th scope="col">Time (UTC)</th>
                    <th scope="col">Who</th>
                    <th scope="col">What</th>
                    <th scope="col">Description</th>
                    <th scope="col">Version</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _page.Items)
                {
                    <tr id="@($"entry-{entry.Id}")">
                        <td class="nowrap">@entry.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss", Culture)</td>
                        <td>
                            @entry.UserName
                            <div class="muted">@Where(entry)</div>
                        </td>
                        <td><span class="badge @Badge(entry.Category)">@Label(entry.Category)</span></td>
                        <td>
                            @entry.Summary
                            @if (!string.IsNullOrEmpty(entry.Details))
                            {
                                <details>
                                    <summary>Details</summary>
                                    <pre class="audit-details">@entry.Details</pre>
                                </details>
                            }
                        </td>
                        <td>
                            @if (entry.ConfigurationVersionId is { } version)
                            {
                                <a href="@($"history/{version}")" aria-label="@($"Configuration version {version}")">@version</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_page.HasNewer || _page.HasOlder)
{
    <nav class="pager" aria-label="Pages">
        @if (_page.HasNewer)
        {
            <a class="button button-secondary" href="@Url(("after", _page.Items[0].Id))">← Newer</a>
        }
        @if (_page.HasOlder)
        {
            <a class="button button-secondary" href="@Url(("before", _page.Items[^1].Id))">Older →</a>
        }
    </nav>
}

@code {
    private const int PageSize = 50;
    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.InvariantCulture;

    private static readonly (AuditCategory Value, string Label)[] Categories =
    [
        (AuditCategory.Configuration, "Configuration changes"),
        (AuditCategory.SignIn, "Sign-ins and sign-outs"),
        (AuditCategory.Security, "Account and security"),
        (AuditCategory.Maintenance, "Backups, downloads and cleanup"),
    ];

    private AuditPage _page = new([], false, false);
    private IReadOnlyList<string> _users = [];
    private AuditCategory? _category;
    private string? _user;
    private long? _version;

    [SupplyParameterFromQuery(Name = "category")]
    public string? Category { get; set; }

    [SupplyParameterFromQuery(Name = "user")]
    public string? User { get; set; }

    [SupplyParameterFromQuery(Name = "version")]
    public long? Version { get; set; }

    [SupplyParameterFromQuery(Name = "before")]
    public long? Before { get; set; }

    [SupplyParameterFromQuery(Name = "after")]
    public long? After { get; set; }

    private bool IsFiltered => _category is not null || _user is not null || _version is not null;

    protected override async Task OnInitializedAsync()
    {
        _category = Enum.TryParse<AuditCategory>(Category, ignoreCase: true, out var category) && Enum.IsDefined(category) ? category : null;
        _user = string.IsNullOrWhiteSpace(User) ? null : User.Trim()[..Math.Min(User.Trim().Length, AuditEntry.MaxUserNameLength)];
        _version = Version is > 0 ? Version : null;

        _users = await AuditLog.GetUserNamesAsync(CancellationToken.None);
        _page = await AuditLog.ReadPageAsync(
            new AuditFilter { Category = _category, UserName = _user, Version = _version },
            Before is > 0 ? Before : null,
            After is > 0 ? After : null,
            PageSize,
            CancellationToken.None);
    }

    private string Url((string Name, long Value) position)
    {
        var query = new Dictionary<string, string?>
        {
            ["category"] = _category?.ToString(),
            ["user"] = _user,
            ["version"] = _version?.ToString(Culture),
            [position.Name] = position.Value.ToString(Culture),
        };
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("audit", query.Where(p => p.Value is not null));
    }

    private static string Where(AuditEntry entry) =>
        entry.ClientIp is null ? entry.Source : $"{entry.Source}, {entry.ClientIp}";

    private static string Label(AuditCategory category) => category switch
    {
        AuditCategory.Configuration => "Configuration",
        AuditCategory.SignIn => "Sign-in",
        AuditCategory.Security => "Security",
        _ => "Maintenance",
    };

    private static string Badge(AuditCategory category) => category switch
    {
        AuditCategory.Configuration => "badge-ok",
        AuditCategory.Security => "badge-warning",
        _ => "badge-muted",
    };
}
