@page "/rate-limits"
@inject IGatewayConfigurationService Configurations
@inject NavigationManager Navigation

<PageTitle>@T("Rate limits") · @ProductInfo.Name</PageTitle>

<h1>
    @T("Rate limits")
    <HelpTip Title="@T("Rate limits")">
        <p>@T("A rate limit allows at most a number of requests per time window, counted per client IP, per client IP and route, or per route for all clients together. Requests over the limit get 429 Too Many Requests. Rejected requests count too, so a client that keeps hammering stays limited until it slows down.")</p>
    </HelpTip>
</h1>

@if (!string.IsNullOrEmpty(Saved))
{
    <div class="alert alert-ok" role="status">@Message(Saved)</div>
}

@if (_errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <strong>@T("The change was not applied.")</strong>
        <ul>
            @foreach (var error in _errors)
            {
                <li>@Message(error)</li>
            }
        </ul>
    </div>
}

<p class="actions">@TM("<a class=\"button\" href=\"rate-limits/new\">Add a rate limit</a> <a class=\"button button-secondary\" href=\"library#rate-limits\">From a template</a>")</p>

@if (_active is not null && _active.Configuration.RateLimits.Count == 0)
{
    <p>@T("No rate limits yet. A good start is a general limit per client IP (e.g. 600 per minute) and a strict one for login pages (e.g. 5 POST requests to /login per minute).")</p>
}
else if (_active is not null)
{
    <table>
        <thead>
            <tr><th scope="col">@T("Name")</th><th scope="col">@T("Limit")</th><th scope="col">@T("For")</th><th scope="col">@T("Status")</th><th scope="col"><span class="visually-hidden">@T("Actions")</span></th></tr>
        </thead>
        <tbody>
            @foreach (var limit in _active.Configuration.RateLimits)
            {
                var name = limit.Name;
                <tr class="@(limit.Enabled ? null : "disabled")">
                    <td>
                        @name
                        @if (!string.IsNullOrEmpty(limit.Description))
                        {
                            <span class="muted cell-note">@limit.Description</span>
                        }
                    </td>
                    <td>@Describe.RateLimit(limit)@(limit.DetectionOnly || _active.Configuration.Settings.DetectionOnly ? " (detection only)" : null)</td>
                    <td>
                        @(limit.Conditions.Count == 0 ? Text.T("All requests") : Describe.Conditions(limit.Conditions))
                        @if (limit.Routes.Count > 0)
                        {
                            <span class="muted cell-note">@Plural(limit.Routes.Count, "Only on route {1}", "Only on routes {1}", string.Join(", ", limit.Routes))</span>
                        }
                    </td>
                    <td>
                        @if (limit.Enabled)
                        {
                            <span class="badge badge-ok">@T("Enabled")</span>
                        }
                        else
                        {
                            <span class="badge badge-muted">@T("Disabled")</span>
                        }
                    </td>
                    <td>
                        <div class="row-actions">
                            <a href="@($"rate-limits/{Uri.EscapeDataString(name)}/edit")">@T("Edit")</a>
                            <form method="post" @formname="@($"toggle-limit-{name}")" @onsubmit="() => ToggleAsync(name)" data-enhance>
                                <AntiforgeryToken />
                                <button type="submit" class="link-button">@(limit.Enabled ? Text.T("Disable") : Text.T("Enable"))</button>
                            </form>
                            <a href="@($"rate-limits/{Uri.EscapeDataString(name)}/delete")">@T("Delete")</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private StoredConfiguration? _active;
    private IReadOnlyList<string> _errors = [];

    [SupplyParameterFromQuery]
    public string? Saved { get; set; }

    protected override async Task OnInitializedAsync() =>
        _active = await Configurations.GetActiveAsync(CancellationToken.None);

    private async Task ToggleAsync(string name)
    {
        var active = await Configurations.GetActiveAsync(CancellationToken.None);
        var configuration = ConfigurationEditing.Clone(active!.Configuration);
        var limit = configuration.RateLimits.FirstOrDefault(l => l.Name == name);
        if (limit is null)
        {
            _errors = [Text.F("Rate limit '{0}' no longer exists.", name)];
            return;
        }

        limit.Enabled = !limit.Enabled;
        var verb = limit.Enabled ? "enabled" : "disabled";
        var result = await Configurations.ActivateIfCurrentAsync(active.Version, configuration, AdminActor.From(HttpContext), $"Rate limit '{name}' {verb}.", CancellationToken.None);
        if (result.Succeeded)
        {
            Navigation.NavigateTo($"rate-limits?saved={Uri.EscapeDataString($"Rate limit '{name}' {verb} (version {result.Version!.Version}).")}");
        }
        else
        {
            _errors = result.Errors;
            _active = await Configurations.GetActiveAsync(CancellationToken.None);
        }
    }
}
