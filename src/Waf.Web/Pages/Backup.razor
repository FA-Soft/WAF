@page "/backup"
@using Microsoft.AspNetCore.Http
@inject IGatewayConfigurationService Configurations
@inject ConfigurationStore Store
@inject ICertificateManager Certificates

<PageTitle>@T("Backup and import") · @ProductInfo.Name</PageTitle>

<h1>
    @T("Backup and import")
    <HelpTip Title="@T("Backup and import")">
        <p>@TM("<strong>Export</strong> saves the active configuration as a JSON file, for example to copy it to another gateway. <strong>Import</strong> loads such a file; you see what changes before it is applied.")</p>
        <p>@TM("A <strong>backup</strong> holds every configuration version. <strong>Restore</strong> replaces the whole history with the backup's, for example on a new server.")</p>
        <p>@T("Secret values, such as the API keys in header conditions, are left out unless you tick \"Include secrets\". When a file without secrets is imported, the gateway keeps the values it already has.")</p>
        <p>@T("Uploaded certificates and their private keys are only in a full backup with \"Include secrets\"; restoring it adds them to this gateway's certificate store.")</p>
    </HelpTip>
</h1>

@if (_active is null)
{
    <div class="alert alert-danger" role="alert">@T("No configuration is active yet.")</div>
}
else
{
    <section class="card section" aria-labelledby="export-heading">
        <h2 id="export-heading">@T("Export the configuration")</h2>
        <p>@TM("Downloads version {0} (the active configuration) as a JSON file. Older versions can be exported from the <a href=\"history\">history</a>.", _active.Version)</p>
        <form method="post" action="export/configuration">
            <AntiforgeryToken />
            <SecretsCheckbox Id="export-secrets" Count="_secrets" />
            <button type="submit" class="button">@T("Download configuration (JSON)")</button>
        </form>
    </section>

    <section class="card section" aria-labelledby="import-heading">
        <h2 id="import-heading">@T("Import a configuration")</h2>
        <p>@T("Load a JSON file exported from this or another gateway. You see exactly what will change before anything is applied, and the import becomes a new version you can roll back.")</p>
        <a class="button button-secondary" href="import">@T("Import a file…")</a>
    </section>

    <section class="card section" aria-labelledby="backup-heading">
        <h2 id="backup-heading">@T("Full backup")</h2>
        <p>@Plural(_versionCount, "Downloads the {0} configuration version and which one is active, as a .zip file.", "Downloads all {0} configuration versions and which one is active, as a .zip file.")</p>
        <form method="post" action="export/backup">
            <AntiforgeryToken />
            <SecretsCheckbox Id="backup-secrets" Count="_secrets" Certificates="_certificates" />
            <button type="submit" class="button">@T("Download backup (.zip)")</button>
        </form>
    </section>

    <section class="card section" aria-labelledby="restore-heading">
        <h2 id="restore-heading">@T("Restore a backup")</h2>

        @if (_restored is { Succeeded: true })
        {
            <div class="alert alert-ok" role="status">
                <strong>@T("Backup restored.")</strong> @TM("Version {0} is active. The previous database was saved as <code>{1}</code>.", _restored.ActiveVersion, _restored.SafetyCopyPath)
                <a href="history">@T("View the history")</a>.
            </div>
        }
        else if (_restored is not null)
        {
            <div class="alert alert-danger" role="alert">
                <strong>@T("The backup was not restored.")</strong> @T("Nothing was changed.")
                <ul>
                    @foreach (var error in _restored.Errors)
                    {
                        <li>@Message(error)</li>
                    }
                </ul>
            </div>
        }

        <p>@TM("Replaces <strong>all</strong> configuration versions with those in the backup and activates the backup's active version. Everything is checked first; if anything is wrong, nothing changes. A copy of the current database is kept next to it.")</p>
        <EditForm Model="Restore" FormName="restore-backup" OnSubmit="RestoreAsync" Enhance enctype="multipart/form-data" class="form">
            <div class="field">
                <label for="backup-file">@T("Backup file (.zip)")</label>
                <input type="file" id="backup-file" name="backupFile" accept=".zip,application/zip" required />
            </div>
            <div class="field checkbox-field">
                <InputCheckbox id="restore-confirm" @bind-Value="Restore!.Confirm" aria-describedby="restore-confirm-help" />
                <label for="restore-confirm">@T("Replace the current configuration and its history")</label>
                <p class="field-help" id="restore-confirm-help">@T("Changes made after the backup was taken are no longer in the history (they stay in the copy of the database).")</p>
            </div>
            <button type="submit" class="button button-danger">@T("Restore backup")</button>
        </EditForm>
    </section>
}

@code {
    private StoredConfiguration? _active;
    private int _secrets;
    private int _versionCount;
    private int _certificates;
    private RestoreResult? _restored;

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "restore-backup")]
    private RestoreFormModel? Restore { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Restore ??= new RestoreFormModel();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _active = await Configurations.GetActiveAsync(CancellationToken.None);
        _secrets = _active is null ? 0 : ConfigurationSecrets.Count(_active.Configuration);
        _versionCount = await Store.CountAsync(CancellationToken.None);
        _certificates = (await Certificates.GetStoredAsync(CancellationToken.None)).Count;
    }

    private async Task RestoreAsync()
    {
        var file = HttpContext?.Request.HasFormContentType == true ? HttpContext.Request.Form.Files.GetFile("backupFile") : null;
        if (file is null || file.Length == 0)
        {
            _restored = RestoreResult.Failed([Text.N("Choose a backup file.")]);
            return;
        }

        if (!Restore!.Confirm)
        {
            _restored = RestoreResult.Failed([Text.N("Tick \"Replace the current configuration and its history\" to confirm.")]);
            return;
        }

        BackupReadResult read;
        await using (var stream = file.OpenReadStream())
        using (var buffer = new MemoryStream())
        {
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;
            read = BackupArchive.Read(buffer);
        }

        _restored = read.Backup is null
            ? RestoreResult.Failed(read.Errors)
            : await Configurations.RestoreBackupAsync(read.Backup, AdminActor.From(HttpContext), CancellationToken.None);
        Restore.Confirm = false;
        await LoadAsync();
    }

}
