@page "/ai/proposals/{Id:long}"
@inject AiAssistant Assistant
@inject IGatewayConfigurationService Configurations
@inject NavigationManager Navigation

<PageTitle>AI proposal @Id · @ProductInfo.Name</PageTitle>

<p><a href="ai">← @T("AI assistant")</a></p>
<h1>AI proposal @Id</h1>

@if (!string.IsNullOrEmpty(Saved))
{
    <div class="alert alert-ok" role="status">@Message(Saved)</div>
}

@if (_errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <ul>
            @foreach (var error in _errors)
            {
                <li>@Message(error)</li>
            }
        </ul>
    </div>
}

@if (_proposal is null)
{
    <p>@T("This proposal does not exist.")</p>
}
else
{
    <section class="card section" aria-labelledby="ai-request-heading">
        <h2 id="ai-request-heading">@T("Request")</h2>
        <p class="ai-prompt">@_proposal.Prompt</p>
        <dl class="details">
            <dt>@T("Asked")</dt>
            <dd>@TM("{0} UTC by {1}, for <a href=\"history/{2}\">version {2}</a>", _proposal.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture), _proposal.UserName, _proposal.BaseVersion)</dd>
            <dt>@T("Status")</dt>
            <dd><span class="badge @AiProposalText.Badge(_proposal.Status)">@AiProposalText.Status(_proposal.Status)</span></dd>
            <dt>@T("Model")</dt>
            <dd><code>@_proposal.Model</code>, @_proposal.InputTokens.ToString("N0", CultureInfo.CurrentCulture) tokens in, @_proposal.OutputTokens.ToString("N0", CultureInfo.CurrentCulture) out</dd>
        </dl>
        @if (!string.IsNullOrEmpty(_proposal.Summary))
        {
            <h3>@T("The assistant's answer")</h3>
            <p class="ai-summary">@_proposal.Summary</p>
        }
    </section>

    @switch (_proposal.Status)
    {
        case AiProposalStatus.Ready when _active is not null && _active.Version != _proposal.BaseVersion:
            <div class="alert alert-warning" role="alert">
                @TM("The configuration changed after this proposal was made (it was made for version {0}; version {1} is running now), so it can no longer be applied. <a href=\"ai\">Ask again</a>.", _proposal.BaseVersion, _active.Version)
            </div>
            <div class="actions">@Discard()</div>
            break;

        case AiProposalStatus.Ready when _review is { Candidate: not null }:
            <section class="preview" aria-labelledby="ai-changes-heading">
                <h2 id="ai-changes-heading">@T("What will change")</h2>
                <ChangeList Changes="_review.Changes" Before="_active!.Configuration" After="_review.Candidate" />
                <p class="muted">@T("Applying creates version {0} and takes effect immediately, without a restart. You can undo it afterwards.", _active.Version + 1)</p>
            </section>
            <div class="actions">
                <form method="post" @formname="ai-approve" @onsubmit="ApproveAsync" data-enhance>
                    <AntiforgeryToken />
                    <button type="submit" class="button">@T("Apply these changes")</button>
                </form>
                @Discard()
            </div>
            break;

        case AiProposalStatus.Ready or AiProposalStatus.Invalid:
            <div class="alert alert-danger" role="alert">
                <strong>@T("This proposal was rejected by the checks and cannot be applied.")</strong> @T("The running configuration is unchanged.")
                <ul>
                    @foreach (var error in _proposal.Status == AiProposalStatus.Invalid ? _proposal.ErrorList : _review?.Errors ?? [])
                    {
                        <li>@Message(error)</li>
                    }
                </ul>
            </div>
            <div class="actions">@Discard()</div>
            break;

        case AiProposalStatus.NoChange:
            <div class="alert alert-info" role="status">@TM("The assistant proposed no change; its answer above says why. <a href=\"ai\">Ask again</a> with more detail.")</div>
            break;

        case AiProposalStatus.Applied:
            <div class="alert alert-ok" role="status">
                @TM("Applied as <a href=\"history/{0}\">version {0}</a> by {1}.", _proposal.AppliedVersion, _proposal.DecidedBy)
            </div>
            @if (_active?.Version == _proposal.AppliedVersion)
            {
                <form method="post" @formname="ai-undo" @onsubmit="UndoAsync" data-enhance class="actions">
                    <AntiforgeryToken />
                    <button type="submit" class="button button-secondary">@T("Undo (restore version {0})", _proposal.BaseVersion)</button>
                </form>
            }
            else
            {
                <p class="muted">@TM("The configuration changed after this proposal was applied. To undo it anyway, restore <a href=\"history/{0}\">version {0}</a>.", _proposal.BaseVersion)</p>
            }
            break;

        case AiProposalStatus.Undone:
            <div class="alert alert-info" role="status">
                @TM("Applied as <a href=\"history/{0}\">version {0}</a>, then undone by {1}: <a href=\"history/{2}\">version {2}</a> restored version {3}.", _proposal.AppliedVersion, _proposal.DecidedBy, _proposal.UndoneVersion, _proposal.BaseVersion)
            </div>
            break;

        case AiProposalStatus.Discarded:
            <div class="alert alert-info" role="status">@T("Discarded by {0} without applying it.", _proposal.DecidedBy)</div>
            break;
    }

    @if (_proposal.ProposalJson is not null)
    {
        <details class="advanced">
            <summary>@T("Show the proposal as it came back")</summary>
            <pre class="code-block">@Pretty(_proposal.ProposalJson)</pre>
        </details>
    }
}

@code {
    private AiProposal? _proposal;
    private StoredConfiguration? _active;
    private ProposalReview? _review;
    private IReadOnlyList<string> _errors = [];

    [Parameter]
    public long Id { get; set; }

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery]
    public string? Saved { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (_proposal is null && HttpContext is not null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }

    private async Task LoadAsync()
    {
        _proposal = await Assistant.GetProposalAsync(Id, CancellationToken.None);
        _active = await Configurations.GetActiveAsync(CancellationToken.None);
        _review = _proposal is { Status: AiProposalStatus.Ready } && _active is not null && _active.Version == _proposal.BaseVersion
            ? AiAssistant.Review(_proposal.ProposalJson, _active.Configuration)
            : null;
    }

    private RenderFragment Discard() =>
        @<form method="post" @formname="ai-discard" @onsubmit="DiscardAsync" data-enhance>
            <AntiforgeryToken />
            <button type="submit" class="button button-secondary">@T("Discard")</button>
        </form>;

    private Task ApproveAsync() => DecideAsync(Assistant.ApproveAsync(Id, Actor, CancellationToken.None), r => Text.F("Applied: version {0} is active now.", r.Version));

    private Task UndoAsync() => DecideAsync(Assistant.UndoAsync(Id, Actor, CancellationToken.None), r => Text.F("Undone: version {0} restored the configuration of version {1}.", r.Version, _proposal!.BaseVersion));

    private Task DiscardAsync() => DecideAsync(Assistant.DiscardAsync(Id, Actor, CancellationToken.None), _ => Text.N("The proposal is discarded."));

    private AuditActor Actor => AdminActor.From(HttpContext, AiAssistant.AuditSource);

    private async Task DecideAsync(Task<AiActionResult> action, Func<AiActionResult, string> message)
    {
        var result = await action;
        if (result.Succeeded)
        {
            Navigation.NavigateTo($"ai/proposals/{Id}?saved={Uri.EscapeDataString(message(result))}");
            return;
        }

        _errors = result.Errors;
        await LoadAsync();
    }

    private static readonly System.Text.Json.JsonSerializerOptions Indented = new() { WriteIndented = true };

    private static string Pretty(string json)
    {
        try
        {
            return System.Text.Json.Nodes.JsonNode.Parse(json)?.ToJsonString(Indented) ?? json;
        }
        catch (System.Text.Json.JsonException)
        {
            return json;
        }
    }
}
