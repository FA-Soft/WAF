@page "/logs/{Id:long}"
@inject RequestLogReader Reader
@inject IGatewayConfigurationService Configurations

<PageTitle>@T("Request {0}", Id) · @ProductInfo.Name</PageTitle>

<p><a href="logs">← @T("Request log")</a></p>

@if (_entry is null)
{
    <h1>@T("Request {0}", Id)</h1>
    <div class="alert alert-danger" role="alert">@T("This log entry does not exist (any more).")</div>
}
else
{
    var (label, badge) = LogFormat.Outcome(_entry);
    var note = LogFormat.Note(_entry);

    <h1><span class="method">@_entry.Method</span> @_entry.Host@_entry.Path</h1>
    <p>
        <span class="badge @badge">@label</span>
        @if (note is { } n)
        {
            <span class="badge @n.Badge">@n.Label</span>
        }
    </p>

    <dl class="details">
        <dt>@T("Time (UTC)")</dt>
        <dd>@LogFormat.Time(_entry.TimestampMs)</dd>
        <dt>@T("Client IP")</dt>
        <dd>@_entry.ClientIp <a href="@($"logs?range=all&ip={Uri.EscapeDataString(_entry.ClientIp)}")">@T("all requests from this client")</a></dd>
        <dt>@T("Host")</dt>
        <dd>@_entry.Host</dd>
        <dt>@T("Path")</dt>
        <dd><code>@_entry.Path</code></dd>
        <dt>@T("Route")</dt>
        <dd>@(_entry.RouteName ?? T("none"))</dd>
        <dt>@T("Forwarded to")</dt>
        <dd>@(_entry.Destination ?? T("not forwarded"))</dd>
        <dt>@T("Rule")</dt>
        <dd>
            @if (_entry.RuleName is null)
            {
                <span>@T("none")</span>
            }
            else
            {
                @_entry.RuleName <a href="@($"logs?range=all&rule={Uri.EscapeDataString(_entry.RuleName)}")">@T("all requests it matched")</a>
            }
        </dd>
        @if (_entry.Event is not null)
        {
            <dt>@T("WAF event")</dt>
            <dd>@_entry.Event</dd>
        }
        @if (_entry.Detail is not null)
        {
            <dt>@T("Detail")</dt>
            <dd><code>@_entry.Detail</code></dd>
        }
        <dt>@T("Status")</dt>
        <dd>@_entry.StatusCode</dd>
        <dt>@T("Latency")</dt>
        <dd>@LogFormat.Latency(_entry.LatencyMs)</dd>
    </dl>
    @if (_configuration is not null)
    {
        <section class="card section" aria-labelledby="actions-heading">
            <h2 id="actions-heading">@T("Turn this into configuration")</h2>
            <p class="muted">@T("Each action opens a pre-filled form; nothing changes until you check it and save.")</p>
            <ul class="log-actions">
                @foreach (var (action, actionLabel, help) in LogActions.Available(_entry, _configuration))
                {
                    <li>
                        <a class="button @(action == LogAction.Allow || action == LogAction.Route ? null : "button-secondary")" href="@LogActions.Url(_entry, action, _configuration)">@actionLabel</a>
                        <span class="muted">@help</span>
                    </li>
                }
            </ul>
        </section>
    }

    <p class="muted">@T("Query strings, headers, cookies and bodies are not logged. For a detected attack, only the matching fragment (at most 100 characters) is kept as evidence, never from a cookie.")</p>
}

@code {
    private RequestEvent? _entry;
    private GatewayConfiguration? _configuration;

    [Parameter]
    public long Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _entry = await Reader.GetAsync(Id, CancellationToken.None);
        _configuration = (await Configurations.GetActiveAsync(CancellationToken.None))?.Configuration;
    }
}
