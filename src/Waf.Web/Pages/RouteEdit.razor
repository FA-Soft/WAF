@page "/routes/new"
@page "/routes/{RouteName}/edit"
@inject ITargetAddressMonitor Addresses
@inject IGatewayConfigurationService Configurations
@inject NavigationManager Navigation
@inject RequestLogReader LogReader

<PageTitle>@(IsNew ? Text.T("Add a route") : Text.T("Edit route {0}", RouteName)) · @ProductInfo.Name</PageTitle>

<p><a href="routes">← @T("Routes")</a></p>
<h1>@(IsNew ? Text.T("Add a route") : Text.T("Edit route '{0}'", RouteName))</h1>

@if (_notFound)
{
    <div class="alert alert-danger" role="alert">@T("Route '{0}' does not exist (any more).", RouteName) <a href="routes">@T("Back to the routes")</a>.</div>
}
else if (Model is not null)
{
    <TemplateNotice Title="@(IsNew ? TemplateLibrary.FindRoute(Template)?.Title : null)" />
    <LogSourceNotice Entry="_logEntry" Missing="_logMissing" Message="@(_logEntry is null ? null : "Enter the backend that should receive these requests.")" />

    @if (_errors.Count > 0)
    {
        <div class="alert alert-danger" role="alert" tabindex="-1">
            <strong>@T("The route was not saved.")</strong> @T("The running configuration is unchanged.")
            <ul>
                @foreach (var error in _errors)
                {
                    <li>@Message(error)</li>
                }
            </ul>
        </div>
    }

    <EditForm Model="Model" FormName="route-edit" OnSubmit="HandleAsync" Enhance class="form">
        <DataAnnotationsValidator />
        <input type="hidden" name="Model.BaseVersion" value="@Model.BaseVersion" />
        <input type="hidden" name="Model.IsNew" value="@(Model.IsNew ? "true" : "false")" />

        <fieldset>
            <legend>@T("Name")</legend>
            @if (Model.IsNew)
            {
                <FormField Id="name" Label="@T("Name")" Help="@T("A short, unique name, e.g. website or api. Rules can refer to it; it cannot be changed later.")" For="() => Model.Name">
                    <InputText id="name" aria-describedby="name-help" @bind-Value="Model.Name" autocomplete="off" />
                </FormField>
            }
            else
            {
                <p><strong>@Model.Name</strong> <span class="muted">@T("(the name cannot be changed because rules may refer to it)")</span></p>
                <input type="hidden" name="Model.Name" value="@Model.Name" />
            }

            <div class="field checkbox-field">
                <InputCheckbox id="enabled" @bind-Value="Model.Enabled" />
                <label for="enabled">@T("Enabled")</label>
                <p class="field-help">@T("A disabled route is kept but not used: its requests get 404.")</p>
            </div>
        </fieldset>

        <fieldset>
            <legend>
                @T("Which requests")
                <HelpTip Title="@T("Which requests")">
                    <p>@T("All conditions you fill in must match. Leave the host names empty and the path at / to handle every request. When several routes match, the one with the most specific path wins.")</p>
                </HelpTip>
            </legend>

            <FormField Id="hosts" Label="@T("Host names")" Optional Help="@T("One per line, e.g. www.example.com or *.example.com for all subdomains. Empty: any host name.")" For="() => Model.Hosts">
                <InputTextArea id="hosts" aria-describedby="hosts-help" @bind-Value="Model.Hosts" rows="3" />
            </FormField>

            <FormField Id="path" Label="@T("Path prefix")" Help="@T("Handles this path and everything below it: /api matches /api and /api/users, not /apix. Use / for all paths.")" For="() => Model.PathPrefix">
                <InputText id="path" aria-describedby="path-help" @bind-Value="Model.PathPrefix" autocomplete="off" />
            </FormField>

            <div class="field" role="group" aria-labelledby="methods-label" aria-describedby="methods-help">
                <span class="label" id="methods-label">@T("Methods") <span class="field-optional">@T("(optional)")</span></span>
                <p class="field-help" id="methods-help">@T("Only these methods. None ticked: every method.")</p>
                <div class="checkbox-row">
                    <label><InputCheckbox @bind-Value="Model.MethodGet" /> GET</label>
                    <label><InputCheckbox @bind-Value="Model.MethodPost" /> POST</label>
                    <label><InputCheckbox @bind-Value="Model.MethodPut" /> PUT</label>
                    <label><InputCheckbox @bind-Value="Model.MethodPatch" /> PATCH</label>
                    <label><InputCheckbox @bind-Value="Model.MethodDelete" /> DELETE</label>
                    <label><InputCheckbox @bind-Value="Model.MethodHead" /> HEAD</label>
                    <label><InputCheckbox @bind-Value="Model.MethodOptions" /> OPTIONS</label>
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>
                @T("Where to")
                <HelpTip Title="@T("Backends")">
                    <p>@T("The server(s) that answer the requests. With several backends, requests are spread over them, and a backend that stops answering is skipped.")</p>
                    <p>@TM("<strong>Failover backends</strong> only get traffic while none of the backends above is healthy: failover 1 first, then 2, and so on. For example a second network address of the same machine, or another machine that can take over. Traffic returns once a backend above is healthy again for 30 seconds.")</p>
                    <p>@T("A backend that refuses the connection is skipped at once, and the request goes to the next one. A request that already reached a backend is never sent again.")</p>
                </HelpTip>
            </legend>

            <FormField Id="destinations" Label="@T("Backends")" Help="@T("One per line: an address such as http://10.0.0.5:8080, https://backend.local:8443 or 10.0.0.5:8080 (http), or a target and port label such as nas/web (see Targets).")" For="() => Model.Destinations">
                <InputTextArea id="destinations" aria-describedby="destinations-help" @bind-Value="Model.Destinations" rows="3" />
            </FormField>

            <FormField Id="failover" Label="@T("Failover backends")" Optional Help="@T("One per line, in the order they take over: line 1 is failover 1. Empty: no failover.")" For="() => Model.FailoverDestinations">
                <InputTextArea id="failover" aria-describedby="failover-help" @bind-Value="Model.FailoverDestinations" rows="2" />
            </FormField>

            @if (!string.IsNullOrWhiteSpace(Model.FailoverDestinations) && string.IsNullOrWhiteSpace(Model.HealthCheckPath))
            {
                <p class="field-help">@T("Tip: set a health check path below. Without one, a backend that stops answering (instead of refusing connections) is only noticed by failing requests, and a stopped backend is tried again every half minute.")</p>
            }

            @if (_targetChoices.Count > 0)
            {
                <div class="field add-target">
                    <label for="add-target">@T("Add a target")</label>
                    <div class="inline-controls">
                        <InputSelect id="add-target" @bind-Value="Model.AddTarget">
                            @foreach (var (line, text) in _targetChoices)
                            {
                                <option value="@line">@text</option>
                            }
                        </InputSelect>
                        <button type="submit" name="Model.Command" value="add-target" class="button button-secondary" formnovalidate>@T("Add")</button>
                        <button type="submit" name="Model.Command" value="add-target-failover" class="button button-secondary" formnovalidate>@T("Add as failover")</button>
                    </div>
                </div>
            }
            else
            {
                <p class="field-help">@TM("Tip: name a machine and its ports once under <a href=\"targets\">Targets</a>, then use it here, so a changed address is changed in one place.")</p>
            }

            <div class="field checkbox-field">
                <InputCheckbox id="preserve-host" @bind-Value="Model.PreserveHost" aria-describedby="preserve-host-help" />
                <label for="preserve-host">@T("Send the original host name to the backend")</label>
                <p class="field-help" id="preserve-host-help">@T("Keep this on for IIS and other servers that host several sites. Off: the backend receives its own address as host name.")</p>
            </div>

            <div class="field checkbox-field">
                <InputCheckbox id="allow-invalid-cert" @bind-Value="Model.AllowInvalidBackendCertificate" aria-describedby="allow-invalid-cert-help" />
                <label for="allow-invalid-cert">@T("Accept a self-signed certificate from https:// backends")</label>
                <p class="field-help" id="allow-invalid-cert-help">@T("Only for backends you control on a trusted network, e.g. a local IIS with a self-signed certificate.")</p>
            </div>
        </fieldset>

        <fieldset>
            <legend>
                @T("HTTPS")
                <HelpTip Title="@T("HTTPS")">
                    <p>@TM("<strong>Redirect</strong>: visitors who use http:// are sent to the same address with https://. Each host name of the route needs a certificate (Certificates page). Let's Encrypt can still check its challenges over http://.")</p>
                    <p>@TM("<strong>HSTS</strong> tells browsers to use only HTTPS for the host name, for the time set on the Certificates page, even when someone types http://. Browsers remember it, so only switch it on when HTTPS works for good.")</p>
                    <p>@T("With both off, the route also works over plain http://.")</p>
                </HelpTip>
            </legend>

            @if (_hostsWithoutCertificate.Count > 0)
            {
                <p class="field-help">@TM("No certificate yet for {0}: add one on the <a href=\"certificates\">Certificates</a> page before redirecting to HTTPS.", string.Join(", ", _hostsWithoutCertificate))</p>
            }

            <div class="field checkbox-field">
                <InputCheckbox id="redirect-http" @bind-Value="Model.RedirectHttp" aria-describedby="redirect-http-help" />
                <label for="redirect-http">@T("Redirect http:// to https://")</label>
                <p class="field-help" id="redirect-http-help">@T("A permanent redirect (308) to the same address over HTTPS.")</p>
            </div>

            <div class="field checkbox-field">
                <InputCheckbox id="hsts" @bind-Value="Model.Hsts" aria-describedby="hsts-help" />
                <label for="hsts">@T("Tell browsers to use HTTPS only (HSTS)")</label>
                <p class="field-help" id="hsts-help">@T("Sends the Strict-Transport-Security header on HTTPS responses.")</p>
            </div>
        </fieldset>

        <fieldset>
            <legend>
                @T("Health check")
                <HelpTip Title="@T("Health check")">
                    <p>@T("With a path, the gateway regularly requests it on each backend and stops sending traffic to a backend that does not answer. Backends that fail real requests are always skipped for a while.")</p>
                </HelpTip>
            </legend>

            <FormField Id="health-path" Label="@T("Health check path")" Optional Help="@T("e.g. /health. Empty: no active health check.")" For="() => Model.HealthCheckPath">
                <InputText id="health-path" aria-describedby="health-path-help" @bind-Value="Model.HealthCheckPath" autocomplete="off" />
            </FormField>

            <div class="field-row">
                <FormField Id="health-interval" Label="@T("Check every (seconds)")" For="() => Model.HealthCheckIntervalSeconds">
                    <InputNumber id="health-interval" @bind-Value="Model.HealthCheckIntervalSeconds" min="1" max="3600" />
                </FormField>
                <FormField Id="health-timeout" Label="@T("Time-out (seconds)")" For="() => Model.HealthCheckTimeoutSeconds">
                    <InputNumber id="health-timeout" @bind-Value="Model.HealthCheckTimeoutSeconds" min="1" max="3600" />
                </FormField>
            </div>
        </fieldset>

        <fieldset>
            <legend>
                @T("When no backend answers")
                <HelpTip Title="@T("Error page")">
                    <p>@T("When no backend answers, visitors get a short error in the format their software expects: a web page for browsers, JSON or XML for programs, a SOAP fault for SOAP clients. It never shows addresses or other internal details; those are in the request log.")</p>
                </HelpTip>
            </legend>
            <FormField Id="error-message" Label="@T("Message for visitors")" Optional Help="@T("Shown on the error, e.g. Planned maintenance until 14:00. One line, at most 300 characters.")" For="() => Model.ErrorMessage">
                <InputText id="error-message" aria-describedby="error-message-help" @bind-Value="Model.ErrorMessage" maxlength="300" autocomplete="off" />
            </FormField>
            <p class="field-help">@T("Visitors whose browser prefers Dutch, French or German get the message in their language; empty: the message above.")</p>
            <div class="field-row">
                <FormField Id="error-message-nl" Label="Nederlands" Optional For="() => Model.ErrorMessageNl">
                    <InputText id="error-message-nl" lang="nl" @bind-Value="Model.ErrorMessageNl" maxlength="300" autocomplete="off" />
                </FormField>
                <FormField Id="error-message-fr" Label="Français" Optional For="() => Model.ErrorMessageFr">
                    <InputText id="error-message-fr" lang="fr" @bind-Value="Model.ErrorMessageFr" maxlength="300" autocomplete="off" />
                </FormField>
                <FormField Id="error-message-de" Label="Deutsch" Optional For="() => Model.ErrorMessageDe">
                    <InputText id="error-message-de" lang="de" @bind-Value="Model.ErrorMessageDe" maxlength="300" autocomplete="off" />
                </FormField>
            </div>
        </fieldset>

        <div class="actions">
            <button type="submit" class="button">@(Model.IsNew ? Text.T("Add route") : Text.T("Save changes"))</button>
            <a class="button button-secondary" href="routes">@T("Cancel")</a>
        </div>
        <p class="muted">@T("Saving creates a new configuration version and takes effect immediately, without a restart.")</p>
    </EditForm>
}

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private IReadOnlyList<string> _errors = [];
    private bool _notFound;
    private IReadOnlyList<string> _certificateHosts = [];

    /// <summary>Host names of the form that no certificate covers (a redirect to HTTPS would fail for them).</summary>
    private IReadOnlyList<string> _hostsWithoutCertificate => Model?.Hosts is not { } hosts
        ? []
        : [.. hosts.Split(['\n', '\r', ',', ' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(host => !_certificateHosts.Any(c => string.Equals(c, host, StringComparison.OrdinalIgnoreCase) || CertificateNames.Matches(c, host)))];

    /// <summary>"nas/web" with "nas · web (http://192.168.1.20:5000)" for every port of every target.</summary>
    private IReadOnlyList<(string Line, string Text)> _targetChoices = [];

    protected override async Task OnParametersSetAsync()
    {
        var configuration = (await Configurations.GetActiveAsync(CancellationToken.None))?.Configuration;
        _certificateHosts = [.. configuration?.Certificates.Select(c => c.HostName) ?? []];
        var targets = configuration?.Targets ?? [];
        _targetChoices = [.. targets.SelectMany(t => t.Ports.Select(p =>
            (RouteFormModel.TargetLine(t.Name, p.Name), Describe.Destinations([new ProxyDestinationOptions { Target = t.Name, TargetPort = p.Name }], targets, Addresses))))];
    }

    /// <summary>The route being edited; null when adding a route.</summary>
    [Parameter]
    public string? RouteName { get; set; }

    /// <summary>Pre-fills a new route from the template library, e.g. "website".</summary>
    [SupplyParameterFromQuery]
    public string? Template { get; set; }

    /// <summary>Pre-fills a new route from a request log entry (its host).</summary>
    [SupplyParameterFromQuery(Name = LogActions.FromLogParameter)]
    public long? FromLog { get; set; }

    private RequestEvent? _logEntry;
    private bool _logMissing;

    [SupplyParameterFromForm(FormName = "route-edit")]
    private RouteFormModel? Model { get; set; }

    private bool IsNew => RouteName is null;

    protected override async Task OnInitializedAsync()
    {
        if (Model is not null)
        {
            return; // posted form
        }

        var active = await Configurations.GetActiveAsync(CancellationToken.None);
        var version = active?.Version ?? 0;
        if (IsNew)
        {
            if (FromLog is { } id && active is not null)
            {
                _logEntry = await LogReader.GetAsync(id, CancellationToken.None);
                _logMissing = _logEntry is null;
                if (_logEntry is not null)
                {
                    Model = LogActions.NewRoute(_logEntry, active.Configuration, version);
                    return;
                }
            }

            Model = RouteFormModel.ForNewRoute(version, Template);
            return;
        }

        var route = active?.Configuration.Routes.FirstOrDefault(r => string.Equals(r.Name, RouteName, StringComparison.OrdinalIgnoreCase));
        if (route is null)
        {
            _notFound = true;
            return;
        }

        Model = RouteFormModel.FromRoute(route, version);
    }

    private async Task HandleAsync(EditContext editContext)
    {
        if (Model!.TryApplyCommand())
        {
            return; // only the form changed; nothing is saved
        }

        if (await editContext.ValidateAsync())
        {
            await SaveAsync();
        }
    }

    private async Task SaveAsync()
    {
        var model = Model!;
        var active = await Configurations.GetActiveAsync(CancellationToken.None);
        if (active is null)
        {
            _errors = [Text.N("No configuration is active yet.")];
            return;
        }

        var configuration = ConfigurationEditing.Clone(active.Configuration);
        var route = model.ToRoute();
        var index = configuration.Routes.ToList().FindIndex(r => string.Equals(r.Name, route.Name, StringComparison.OrdinalIgnoreCase));

        if (model.IsNew)
        {
            if (index >= 0)
            {
                _errors = [Text.F("A route named '{0}' already exists. Choose another name.", route.Name)];
                return;
            }

            configuration.Routes.Add(route);
        }
        else if (index < 0)
        {
            _errors = [Text.F("Route '{0}' no longer exists; it was deleted in the meantime.", route.Name)];
            return;
        }
        else
        {
            configuration.Routes[index] = route;
        }

        var verb = model.IsNew ? "added" : "changed";
        var result = await Configurations.ActivateIfCurrentAsync(model.BaseVersion, configuration, AdminActor.From(HttpContext), $"Route '{route.Name}' {verb}.", CancellationToken.None);
        if (!result.Succeeded)
        {
            _errors = result.Errors;
            return;
        }

        Navigation.NavigateTo($"routes?saved={Uri.EscapeDataString($"Route '{route.Name}' {verb} (version {result.Version!.Version}).")}");
    }
}
