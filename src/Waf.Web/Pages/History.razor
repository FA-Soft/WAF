@page "/history"
@inject ConfigurationStore Store
@inject AuditLogStore Audit

<PageTitle>@T("Configuration history") · @ProductInfo.Name</PageTitle>

<h1>
    @T("Configuration history")
    <HelpTip Title="@T("Configuration history")">
        <p>@T("Every change to the configuration is kept as a numbered version. Only checked, working configurations become active; the active one is marked. Open a version to see what it changed, to restore it or to export it.")</p>
    </HelpTip>
</h1>

@if (!string.IsNullOrEmpty(Saved))
{
    <div class="alert alert-ok" role="status">@Message(Saved)</div>
}

<p class="actions">@TM("<a class=\"button button-secondary\" href=\"backup\">Backup and import</a> <a class=\"button button-secondary\" href=\"audit?category=Configuration\">Audit log</a>")</p>

@if (_versions.Count == 0)
{
    <p>@T("No versions stored yet.")</p>
}
else
{
    <table>
        <thead>
            <tr><th scope="col">@T("Version")</th><th scope="col">@T("Stored (UTC)")</th><th scope="col">@T("By")</th><th scope="col">@T("Description")</th><th scope="col">@T("Audit")</th><th scope="col"><span class="visually-hidden">@T("Actions")</span></th></tr>
        </thead>
        <tbody>
            @foreach (var version in _versions)
            {
                <tr>
                    <td>
                        @version.Version
                        @if (version.Version == _activeVersion)
                        {
                            <span class="badge badge-ok">@T("Active")</span>
                        }
                    </td>
                    <td>@version.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>@Message(version.Author)</td>
                    <td>@Message(version.Comment)</td>
                    <td>
                        @if (_audited.Contains(version.Version))
                        {
                            <a href="@($"audit?version={version.Version}")" aria-label="@($"Audit log of version {version.Version}")">@T("Audit entry")</a>
                        }
                    </td>
                    <td><a href="@($"history/{version.Version}")" aria-label="@($"Details of version {version.Version}")">@(version.Version == _activeVersion ? Text.T("Details") : Text.T("Details and restore"))</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<StoredConfiguration> _versions = [];
    private long? _activeVersion;
    private HashSet<long> _audited = [];

    [SupplyParameterFromQuery]
    public string? Saved { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _versions = await Store.GetHistoryAsync(100, CancellationToken.None);
        var entries = await Audit.GetForVersionsAsync(_versions.Select(v => v.Version), CancellationToken.None);
        _audited = [.. entries.Select(e => e.ConfigurationVersionId!.Value)];
        _activeVersion = (await Store.GetLastKnownGoodAsync(CancellationToken.None))?.Version;
    }
}
