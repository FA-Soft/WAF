@page "/logs/settings"
@using System.ComponentModel.DataAnnotations
@inject IGatewayConfigurationService Configurations
@inject RequestLogMaintenance Maintenance
@inject ILogRetention Retention
@inject IMetricsHistory History
@inject NavigationManager Navigation
@inject AuditLogStore Audit

<PageTitle>@T("Log retention") · @ProductInfo.Name</PageTitle>

<p><a href="logs">← @T("Request log")</a></p>
<h1>
    @T("Log retention")
    <HelpTip Title="@T("Log retention")">
        <p>@T("The request log is kept in events.db in the data folder. A background job checks it every minute and removes the oldest entries when they are older than the age limit, or when the log grows close to its size limit. The file never grows beyond the size limit; space of removed entries is reused for new ones.")</p>
    </HelpTip>
</h1>

@if (!string.IsNullOrEmpty(Saved))
{
    <div class="alert alert-ok" role="status">@Message(Saved)</div>
}

@if (_cleaned is { } cleaned)
{
    <div class="alert @(cleaned.Error is null ? "alert-ok" : "alert-danger")" role="status">
        @if (cleaned.Error is null)
        {
            <span>@Plural(cleaned.Deleted, "Cleanup finished: {0} entry removed.", "Cleanup finished: {0} entries removed.")</span>
        }
        else
        {
            <span>@T("Cleanup failed: {0}", Message(cleaned.Error))</span>
        }
    </div>
}

<section class="cards" aria-label="@T("Request log size")">
    <div class="card">
        <h2>@T("Size on disk")</h2>
        @if (_info is { } info)
        {
            <p class="metric">@Megabytes(info.FileBytes)</p>
            <p class="muted">@T("of at most {0} MB ({1})", _settings.MaxDatabaseSizeMb.ToString("N0", CultureInfo.CurrentCulture), Percent(info.FileBytes))</p>
            <meter class="size-meter" min="0" max="1" low="@RequestLogMaintenance.LowWatermark" high="@RequestLogMaintenance.HighWatermark" optimum="0" value="@Math.Clamp(Fraction(info.FileBytes), 0, 1).ToString("0.###", Culture)" aria-label="@T("Share of the size limit in use")">@Percent(info.FileBytes)</meter>
        }
        else
        {
            <p class="metric">@T("0 MB")</p>
            <p class="muted">@T("No requests have been logged yet.")</p>
        }
    </div>
    <div class="card">
        <h2>@T("Entries")</h2>
        <p class="metric">@((_info?.Entries ?? 0).ToString("N0", CultureInfo.CurrentCulture))</p>
        <p class="muted">
            @if (_info?.Oldest is { } oldest)
            {
                <span>@T("oldest from {0} UTC", oldest.UtcDateTime.ToString("yyyy-MM-dd HH:mm", Culture))</span>
            }
        </p>
    </div>
    <div class="card">
        <h2>@T("Last cleanup")</h2>
        @if (Retention.LastRun is { } last)
        {
            <p class="metric">@Plural(last.Deleted, "{0} removed", "{0} removed")</p>
            <p class="muted">
                @T("{0} UTC: {1} by age, {2} by size", last.FinishedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss", Culture), last.DeletedByAge.ToString("N0", CultureInfo.CurrentCulture), last.DeletedBySize.ToString("N0", CultureInfo.CurrentCulture))
            </p>
            @if (last.Error is not null)
            {
                <p class="field-error">@last.Error</p>
            }
        }
        else
        {
            <p class="metric">@T("Not yet")</p>
            <p class="muted">@T("The first run starts shortly after the gateway starts, then every minute.")</p>
        }
        <form method="post" @formname="cleanup-now" @onsubmit="CleanUpAsync" data-enhance>
            <AntiforgeryToken />
            <button type="submit" class="button button-secondary">@T("Clean up now")</button>
        </form>
    </div>
</section>

@if (_errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <strong>@T("The settings were not saved.")</strong> @T("The running configuration is unchanged.")
        <ul>
            @foreach (var error in _errors)
            {
                <li>@Message(error)</li>
            }
        </ul>
    </div>
}

@if (Model is not null)
{
    <EditForm Model="Model" FormName="log-retention" OnValidSubmit="SaveAsync" Enhance class="form">
        <DataAnnotationsValidator />
        <ValidationList Class="alert alert-danger validation-summary" />
        <input type="hidden" name="Model.BaseVersion" value="@Model.BaseVersion" />
        <fieldset>
            <legend>@T("Limits")</legend>
            <FormField Id="max-age" Label="@T("Keep entries for (days)")" Help="@T("Older entries are removed. 0 keeps entries regardless of age; the size limit still applies.")" For="() => Model.MaxAgeDays">
                <InputNumber id="max-age" aria-describedby="max-age-help" @bind-Value="Model.MaxAgeDays" min="0" max="@LogRetentionSettings.MaxMaxAgeDays" />
            </FormField>
            <FormField Id="max-size" Label="@T("Maximum size (MB)")" Help="@SizeHelp" For="() => Model.MaxDatabaseSizeMb">
                <InputNumber id="max-size" aria-describedby="max-size-help" @bind-Value="Model.MaxDatabaseSizeMb" min="@LogRetentionSettings.MinDatabaseSizeMb" max="@LogRetentionSettings.MaxDatabaseSizeLimitMb" />
            </FormField>
        </fieldset>
        <div class="actions">
            <button type="submit" class="button">@T("Save")</button>
        </div>
        <p class="muted">@T("Saving creates a new configuration version. New limits apply at the next cleanup (within a minute), or press \"Clean up now\".")</p>
    </EditForm>
}

<section aria-labelledby="history-heading">
    <h2 id="history-heading">
        @T("Traffic history")
        <HelpTip Title="@T("Traffic history")">
            <p>@T("The traffic counts of the performance dashboard are kept in metrics.db in the data folder, apart from the request log. The older the data, the coarser it is kept: per second for the last days, then per minute, hour, day, week and month. A background job adds up completed periods into the coarser ones every minute and removes what is older than its tier keeps, so the file stays small. The tiers are host settings (Gateway:Metrics:Retention).")</p>
        </HelpTip>
    </h2>
    @if (!History.Enabled)
    {
        <p class="muted">@T("Switched off in the host settings (Gateway:Metrics:Enabled).")</p>
    }
    else
    {
        <section class="cards" aria-label="@T("Traffic history size")">
            <div class="card">
                <h3 class="card-heading">@T("Size on disk")</h3>
                <p class="metric">@Megabytes(_history?.FileBytes ?? 0)</p>
                <p class="muted">@T("metrics.db; at most a few hundred MB for three years of a busy site")</p>
            </div>
            <div class="card">
                <h3 class="card-heading">@T("Last rollup")</h3>
                @if (History.LastRun is { } run)
                {
                    <p class="metric">@Plural(run.Deleted, "{0} removed", "{0} removed")</p>
                    <p class="muted">@T("{0} UTC: {1} rows added up", run.FinishedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss", Culture), run.RolledUp.ToString("N0", CultureInfo.CurrentCulture))</p>
                    @if (run.Error is not null)
                    {
                        <p class="field-error">@run.Error</p>
                    }
                }
                else
                {
                    <p class="metric">@T("Not yet")</p>
                    <p class="muted">@T("The first run starts shortly after the gateway starts, then every minute.")</p>
                }
            </div>
        </section>
        @if (_history is { } history)
        {
            <div class="table-scroll">
                <table>
                    <caption>@T("What is kept, from fine to coarse")</caption>
                    <thead><tr><th scope="col">@T("Stored per")</th><th scope="col">@T("Kept for")</th><th scope="col">@T("Oldest stored")</th><th scope="col">@T("Newest stored")</th></tr></thead>
                    <tbody>
                        @foreach (var tier in history.Tiers)
                        {
                            <tr>
                                <th scope="row">@TierName(tier.Tier)</th>
                                <td>@KeptFor(tier.KeptFor)</td>
                                <td>@(tier.Oldest is { } oldestBucket ? oldestBucket.UtcDateTime.ToString("yyyy-MM-dd HH:mm", Culture) + " UTC" : T("nothing yet"))</td>
                                <td>@(tier.Newest is { } newestBucket ? newestBucket.UtcDateTime.ToString("yyyy-MM-dd HH:mm", Culture) + " UTC" : T("nothing yet"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.InvariantCulture;

    private static string SizeHelp => T(
        "When the log reaches {0} of this, the oldest entries are removed until it is at {1}. At least {2} MB. Rough guide: 1 MB holds about {3} requests.",
        RequestLogMaintenance.HighWatermark.ToString("P0", CultureInfo.CurrentCulture),
        RequestLogMaintenance.LowWatermark.ToString("P0", CultureInfo.CurrentCulture),
        LogRetentionSettings.MinDatabaseSizeMb,
        4000.ToString("N0", CultureInfo.CurrentCulture));

    private LogDatabaseInfo? _info;
    private MetricsStorageStatus? _history;
    private LogRetentionSettings _settings = new();
    private LogCleanupResult? _cleaned;
    private IReadOnlyList<string> _errors = [];

    [SupplyParameterFromQuery]
    public string? Saved { get; set; }

    [SupplyParameterFromForm(FormName = "log-retention")]
    private LogRetentionFormModel? Model { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var active = await Configurations.GetActiveAsync(CancellationToken.None);
        _settings = active?.Configuration.Settings.LogRetention ?? new LogRetentionSettings();
        Model ??= new LogRetentionFormModel
        {
            BaseVersion = active?.Version ?? 0,
            MaxAgeDays = _settings.MaxAgeDays,
            MaxDatabaseSizeMb = _settings.MaxDatabaseSizeMb,
        };
        await LoadInfoAsync();
    }

    private async Task LoadInfoAsync()
    {
        try
        {
            _info = await Maintenance.GetInfoAsync(CancellationToken.None);
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            _info = null; // being created right now
        }

        _history = await History.GetStatusAsync(CancellationToken.None);
    }

    private async Task CleanUpAsync()
    {
        _cleaned = await Retention.CleanUpNowAsync(CancellationToken.None);
        await Audit.RecordAsync(
            AuditCategory.Maintenance,
            AuditActions.LogsCleaned,
            AdminActor.From(HttpContext),
            _cleaned.Error is null ? $"Request log cleaned up now: {_cleaned.Deleted:N0} entries deleted." : "Request log cleanup started now; it failed.",
            _cleaned.Error);
        await LoadInfoAsync();
    }

    private async Task SaveAsync()
    {
        var model = Model!;
        var active = await Configurations.GetActiveAsync(CancellationToken.None);
        var configuration = ConfigurationEditing.Clone(active!.Configuration);
        configuration.Settings.LogRetention.MaxAgeDays = model.MaxAgeDays;
        configuration.Settings.LogRetention.MaxDatabaseSizeMb = model.MaxDatabaseSizeMb;

        var result = await Configurations.ActivateIfCurrentAsync(model.BaseVersion, configuration, AdminActor.From(HttpContext), "Log retention changed.", CancellationToken.None);
        if (!result.Succeeded)
        {
            _errors = result.Errors;
            return;
        }

        Navigation.NavigateTo($"logs/settings?saved={Uri.EscapeDataString($"Log retention saved (version {result.Version!.Version}).")}");
    }

    private static string TierName(MetricsTier tier) => tier switch
    {
        MetricsTier.Second => T("second"),
        MetricsTier.Minute => T("minute"),
        MetricsTier.Hour => T("hour"),
        MetricsTier.Day => T("day"),
        MetricsTier.Week => T("week (from Monday)"),
        _ => T("month"),
    };

    private static string KeptFor(TimeSpan keep) =>
        keep.TotalDays >= 1 && keep.Ticks % TimeSpan.TicksPerDay == 0
            ? Plural((long)keep.TotalDays, "{0} day", "{0} days")
            : Plural((long)Math.Round(keep.TotalHours), "{0} hour", "{0} hours");

    private double Fraction(long bytes) => (double)bytes / ((long)_settings.MaxDatabaseSizeMb * 1024 * 1024);

    private string Percent(long bytes) => Fraction(bytes).ToString("P0", CultureInfo.CurrentCulture);

    private static string Megabytes(long bytes) =>
        bytes < 1024 * 1024 ? (bytes / 1024.0).ToString("N0", CultureInfo.CurrentCulture) + " KB" : (bytes / (1024.0 * 1024)).ToString("N1", CultureInfo.CurrentCulture) + " MB";
}
