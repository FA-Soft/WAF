@page "/rules/{RuleName}/delete"
@inject IGatewayConfigurationService Configurations
@inject NavigationManager Navigation

<PageTitle>Delete rule @RuleName · @ProductInfo.Name</PageTitle>

<p><a href="rules">← Rules</a></p>
<h1>Delete rule '@RuleName'?</h1>

@if (_rule is null)
{
    <div class="alert alert-danger" role="alert">Rule '@RuleName' does not exist (any more). <a href="rules">Back to the rules</a>.</div>
}
else
{
    <dl class="details">
        <dt>When</dt><dd>@Describe.Conditions(_rule.Conditions)</dd>
        <dt>Then</dt><dd>@Describe.Action(_rule, globalDetectionOnly: false)</dd>
    </dl>

    @if (_errors.Count > 0)
    {
        <div class="alert alert-danger" role="alert">
            <strong>The rule was not deleted.</strong>
            <ul>
                @foreach (var error in _errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <p>The deletion is stored as a new configuration version, so it can be undone by restoring the previous version. To stop the rule only for a while, disable it instead.</p>
    <form method="post" @formname="rule-delete" @onsubmit="DeleteAsync" data-enhance class="actions">
        <AntiforgeryToken />
        <input type="hidden" name="BaseVersion" value="@_baseVersion" />
        <button type="submit" class="button button-danger">Delete rule</button>
        <a class="button button-secondary" href="rules">Cancel</a>
    </form>
}

@code {
    private WafRule? _rule;
    private IReadOnlyList<string> _errors = [];
    private long _baseVersion;

    [Parameter]
    public string RuleName { get; set; } = string.Empty;

    [SupplyParameterFromForm(FormName = "rule-delete")]
    private long? BaseVersion { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var active = await Configurations.GetActiveAsync(CancellationToken.None);
        _baseVersion = active?.Version ?? 0;
        _rule = active?.Configuration.Rules.FirstOrDefault(r => string.Equals(r.Name, RuleName, StringComparison.OrdinalIgnoreCase));
    }

    private async Task DeleteAsync()
    {
        var active = await Configurations.GetActiveAsync(CancellationToken.None);
        var configuration = ConfigurationEditing.Clone(active!.Configuration);
        var rule = configuration.Rules.FirstOrDefault(r => string.Equals(r.Name, RuleName, StringComparison.OrdinalIgnoreCase));
        if (rule is null)
        {
            _errors = [$"Rule '{RuleName}' no longer exists."];
            return;
        }

        configuration.Rules.Remove(rule);
        var result = await Configurations.ActivateIfCurrentAsync(BaseVersion ?? active.Version, configuration, "admin UI", $"Rule '{rule.Name}' deleted.", CancellationToken.None);
        if (!result.Succeeded)
        {
            _errors = result.Errors;
            return;
        }

        Navigation.NavigateTo($"rules?saved={Uri.EscapeDataString($"Rule '{rule.Name}' deleted (version {result.Version!.Version}).")}");
    }
}
