@page "/rules/{RuleName}/delete"
@inject IGatewayConfigurationService Configurations
@inject NavigationManager Navigation

<PageTitle>@T("Delete rule {0}", RuleName) · @ProductInfo.Name</PageTitle>

<p><a href="rules">← @T("Rules")</a></p>
<h1>@T("Delete rule '{0}'?", RuleName)</h1>

@if (_rule is null)
{
    <div class="alert alert-danger" role="alert">@T("Rule '{0}' does not exist (any more).", RuleName) <a href="rules">@T("Back to the rules")</a>.</div>
}
else
{
    <dl class="details">
        <dt>@T("When")</dt><dd>@Describe.Conditions(_rule.Conditions)</dd>
        <dt>@T("Then")</dt><dd>@Describe.Action(_rule, globalDetectionOnly: false)</dd>
    </dl>

    @if (_errors.Count > 0)
    {
        <div class="alert alert-danger" role="alert">
            <strong>@T("The rule was not deleted.")</strong>
            <ul>
                @foreach (var error in _errors)
                {
                    <li>@Message(error)</li>
                }
            </ul>
        </div>
    }

    <p>@T("The deletion is stored as a new configuration version, so it can be undone by restoring the previous version. To stop the rule only for a while, disable it instead.")</p>
    <form method="post" @formname="rule-delete" @onsubmit="DeleteAsync" data-enhance class="actions">
        <AntiforgeryToken />
        <input type="hidden" name="BaseVersion" value="@_baseVersion" />
        <button type="submit" class="button button-danger">@T("Delete rule")</button>
        <a class="button button-secondary" href="rules">@T("Cancel")</a>
    </form>
}

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private WafRule? _rule;
    private IReadOnlyList<string> _errors = [];
    private long _baseVersion;

    [Parameter]
    public string RuleName { get; set; } = string.Empty;

    [SupplyParameterFromForm(FormName = "rule-delete")]
    private long? BaseVersion { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var active = await Configurations.GetActiveAsync(CancellationToken.None);
        _baseVersion = active?.Version ?? 0;
        _rule = active?.Configuration.Rules.FirstOrDefault(r => string.Equals(r.Name, RuleName, StringComparison.OrdinalIgnoreCase));
    }

    private async Task DeleteAsync()
    {
        var active = await Configurations.GetActiveAsync(CancellationToken.None);
        var configuration = ConfigurationEditing.Clone(active!.Configuration);
        var rule = configuration.Rules.FirstOrDefault(r => string.Equals(r.Name, RuleName, StringComparison.OrdinalIgnoreCase));
        if (rule is null)
        {
            _errors = [Text.F("Rule '{0}' no longer exists.", RuleName)];
            return;
        }

        configuration.Rules.Remove(rule);
        var result = await Configurations.ActivateIfCurrentAsync(BaseVersion ?? active.Version, configuration, AdminActor.From(HttpContext), $"Rule '{rule.Name}' deleted.", CancellationToken.None);
        if (!result.Succeeded)
        {
            _errors = result.Errors;
            return;
        }

        Navigation.NavigateTo($"rules?saved={Uri.EscapeDataString($"Rule '{rule.Name}' deleted (version {result.Version!.Version}).")}");
    }
}
