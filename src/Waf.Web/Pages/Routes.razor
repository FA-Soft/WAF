@page "/routes"
@inject ITargetAddressMonitor Addresses
@inject IRouteFailoverMonitor Failover
@inject IGatewayConfigurationService Configurations
@inject NavigationManager Navigation

<PageTitle>@T("Routes") · @ProductInfo.Name</PageTitle>

<h1>
    @T("Routes")
    <HelpTip Title="@T("Routes")">
        <p>@T("A route decides which backend receives a request, based on the host name, the path and the method. Requests that match no route get 404. When several routes match, the most specific path wins.")</p>
    </HelpTip>
</h1>

@if (!string.IsNullOrEmpty(Saved))
{
    <div class="alert alert-ok" role="status">@Message(Saved)</div>
}

@if (_errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <strong>@T("The change was not applied.")</strong>
        <ul>
            @foreach (var error in _errors)
            {
                <li>@Message(error)</li>
            }
        </ul>
    </div>
}

<p class="actions">@TM("<a class=\"button\" href=\"routes/new\">Add a route</a> <a class=\"button button-secondary\" href=\"library#routes\">From a template</a>")</p>

@if (_active is not null && _active.Configuration.Routes.Count == 0)
{
    <p>@T("No routes yet: every public request gets 404. Add a route to forward traffic to a backend.")</p>
}
else if (_active is not null)
{
    <table>
        <thead>
            <tr><th scope="col">@T("Name")</th><th scope="col">@T("Handles")</th><th scope="col">@T("Forwards to")</th><th scope="col">@T("Status")</th><th scope="col"><span class="visually-hidden">@T("Actions")</span></th></tr>
        </thead>
        <tbody>
            @foreach (var route in _active.Configuration.Routes)
            {
                var name = route.Name;
                <tr class="@(route.Enabled ? null : "disabled")">
                    <td>@name</td>
                    <td>
                        @Describe.Match(route.Match)
                        @if (route.Https.RedirectHttp || route.Https.Hsts)
                        {
                            <div class="muted">@(route.Https.RedirectHttp && route.Https.Hsts ? Text.T("HTTPS only, with HSTS") : route.Https.RedirectHttp ? Text.T("HTTPS only") : Text.T("HSTS on HTTPS"))</div>
                        }
                    </td>
                    <td>@Describe.Destinations(route.Destinations, _active.Configuration.Targets, Addresses)</td>
                    <td>
                        @if (route.Enabled && _onFailover.TryGetValue(name, out var failover))
                        {
                            <span class="badge badge-warning" title="@T("No primary backend is healthy; traffic goes to {0}.", failover.Destinations)">@T("On failover {0} since {1}", failover.Failover, Describe.Time(failover.Since))</span>
                        }
                        else if (route.Enabled)
                        {
                            <span class="badge badge-ok">@T("Enabled")</span>
                        }
                        else
                        {
                            <span class="badge badge-muted">@T("Disabled")</span>
                        }
                    </td>
                    <td><div class="row-actions">
                        <a href="@($"routes/{Uri.EscapeDataString(name)}/edit")">@T("Edit")</a>
                        <form method="post" @formname="@($"toggle-{name}")" @onsubmit="() => ToggleAsync(name)" data-enhance>
                            <AntiforgeryToken />
                            <button type="submit" class="link-button">@(route.Enabled ? Text.T("Disable") : Text.T("Enable"))</button>
                        </form>
                        <a href="@($"routes/{Uri.EscapeDataString(name)}/delete")">@T("Delete")</a>
                    </div></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private StoredConfiguration? _active;
    private IReadOnlyList<string> _errors = [];

    /// <summary>Confirmation shown after a change, e.g. "Route 'api' saved as version 4."</summary>
    [SupplyParameterFromQuery]
    public string? Saved { get; set; }

    /// <summary>Routes whose traffic goes to a failover backend right now.</summary>
    private Dictionary<string, RouteFailoverStatus> _onFailover = [];

    protected override async Task OnInitializedAsync()
    {
        _active = await Configurations.GetActiveAsync(CancellationToken.None);
        _onFailover = Failover.Statuses.ToDictionary(s => s.RouteName, StringComparer.OrdinalIgnoreCase);
    }

    private async Task ToggleAsync(string name)
    {
        var active = await Configurations.GetActiveAsync(CancellationToken.None);
        var configuration = ConfigurationEditing.Clone(active!.Configuration);
        var route = configuration.Routes.FirstOrDefault(r => r.Name == name);
        if (route is null)
        {
            _errors = [Text.F("Route '{0}' no longer exists.", name)];
            return;
        }

        route.Enabled = !route.Enabled;
        var verb = route.Enabled ? "enabled" : "disabled";
        var result = await Configurations.ActivateIfCurrentAsync(active.Version, configuration, AdminActor.From(HttpContext), $"Route '{name}' {verb}.", CancellationToken.None);
        if (result.Succeeded)
        {
            Navigation.NavigateTo($"routes?saved={Uri.EscapeDataString($"Route '{name}' {verb} (version {result.Version!.Version}).")}");
        }
        else
        {
            _errors = result.Errors;
            _active = await Configurations.GetActiveAsync(CancellationToken.None);
        }
    }
}
