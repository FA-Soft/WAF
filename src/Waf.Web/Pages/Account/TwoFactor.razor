@page "/account/two-factor"
@inject UserManager<IdentityUser> Users
@inject SignInManager<IdentityUser> SignIn
@inject NavigationManager Navigation
@inject AuditLogStore Audit

<PageTitle>Two-factor sign-in · @ProductInfo.Name</PageTitle>

<p><a href="account">← Your account</a></p>
<h1>
    Two-factor sign-in
    <HelpTip Title="Two-factor sign-in">
        <p>With two-factor sign-in, signing in needs your password and a 6-digit code from an authenticator app on your phone (for example Microsoft Authenticator, Google Authenticator or 1Password). Someone who learns your password still cannot sign in. Remote access to the admin UI requires it.</p>
    </HelpTip>
</h1>

@if (_errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in _errors)
        {
            <p>@error</p>
        }
    </div>
}

@if (_newCodes is { } codes)
{
    <div class="alert alert-warning" role="status">
        <strong>@_codesTitle</strong>
        <p>Save these recovery codes somewhere safe, apart from your phone (print them, or keep them in a password manager). Each one signs you in once if you lose your phone. They are shown only now.</p>
        <ol class="recovery-codes">
            @foreach (var recoveryCode in codes)
            {
                <li><code>@recoveryCode</code></li>
            }
        </ol>
    </div>
}

@if (_enabled)
{
    <p><span class="badge badge-ok">On</span> Signing in needs your password and a code from your authenticator app.</p>
    <p>Recovery codes left: <strong>@_recoveryCodesLeft</strong>@(_recoveryCodesLeft <= 3 ? " — make new ones soon." : ".")</p>

    <EditForm Model="Codes" FormName="new-recovery-codes" OnValidSubmit="NewRecoveryCodesAsync" Enhance class="form">
        <DataAnnotationsValidator />
        <fieldset>
            <legend>New recovery codes</legend>
            <p class="muted">Replaces all recovery codes; the old ones stop working.</p>
            <FormField Id="codes-password" Label="Password" For="() => Codes!.Password">
                <input id="codes-password" type="password" name="Codes.Password" autocomplete="current-password" />
            </FormField>
            <button type="submit" class="button button-secondary">Make new recovery codes</button>
        </fieldset>
    </EditForm>

    <EditForm Model="Disable" FormName="disable-two-factor" OnValidSubmit="DisableAsync" Enhance class="form">
        <DataAnnotationsValidator />
        <fieldset>
            <legend>Turn off</legend>
            <p class="muted">Signing in then needs only your password. The authenticator app entry and the recovery codes stop working.</p>
            <FormField Id="disable-password" Label="Password" For="() => Disable!.Password">
                <input id="disable-password" type="password" name="Disable.Password" autocomplete="current-password" />
            </FormField>
            <button type="submit" class="button button-danger">Turn off two-factor sign-in</button>
        </fieldset>
    </EditForm>
}
else
{
    <p><span class="badge badge-warning">Off</span> Signing in needs only your password.</p>

    <ol class="setup-steps">
        <li>
            <p>Open your authenticator app, add an account and scan this QR code.</p>
            <img class="qr-code" src="@_qrCode" width="200" height="200" alt="QR code to add @ProductInfo.Name to an authenticator app" />
            <p class="muted">Can't scan it? Enter this key instead (time-based, 6 digits): <code class="authenticator-key">@_formattedKey</code></p>
        </li>
        <li>
            <p>Enter the 6-digit code the app now shows.</p>
            <EditForm Model="Enable" FormName="enable-two-factor" OnValidSubmit="EnableAsync" Enhance class="form">
                <DataAnnotationsValidator />
                <FormField Id="enable-code" Label="Code" For="() => Enable!.Code">
                    <input id="enable-code" name="Enable.Code" inputmode="numeric" autocomplete="one-time-code" maxlength="9" />
                </FormField>
                <button type="submit" class="button">Turn on two-factor sign-in</button>
            </EditForm>
        </li>
    </ol>
}

@code {
    private IdentityUser _user = null!;
    private bool _enabled;
    private int _recoveryCodesLeft;
    private string? _qrCode;
    private string? _formattedKey;
    private IReadOnlyList<string>? _newCodes;
    private string? _codesTitle;
    private IReadOnlyList<string> _errors = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm(FormName = "enable-two-factor")]
    private EnableTwoFactorFormModel? Enable { get; set; }

    [SupplyParameterFromForm(FormName = "new-recovery-codes")]
    private ConfirmPasswordFormModel? Codes { get; set; }

    [SupplyParameterFromForm(FormName = "disable-two-factor")]
    private ConfirmPasswordFormModel? Disable { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Enable ??= new EnableTwoFactorFormModel();
        Codes ??= new ConfirmPasswordFormModel();
        Disable ??= new ConfirmPasswordFormModel();

        var user = await Users.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            Navigation.NavigateTo(AdminIdentity.LoginPath.TrimStart('/'));
            return;
        }

        _user = user;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _enabled = await Users.GetTwoFactorEnabledAsync(_user);
        if (_enabled)
        {
            _recoveryCodesLeft = await Users.CountRecoveryCodesAsync(_user);
            return;
        }

        // The key is kept until 2FA is on, so reloading this page shows the same QR code.
        var key = await Users.GetAuthenticatorKeyAsync(_user);
        if (string.IsNullOrEmpty(key))
        {
            await Users.ResetAuthenticatorKeyAsync(_user);
            await SignIn.RefreshSignInAsync(_user); // the security stamp changed
            key = await Users.GetAuthenticatorKeyAsync(_user);
        }

        _formattedKey = Authenticator.FormatKey(key!);
        _qrCode = Authenticator.QrCodeDataUri(Authenticator.SetupUri(_user.UserName!, key!));
    }

    private async Task EnableAsync()
    {
        var code = AdminSignIn.NormalizeCode(Enable!.Code);
        if (!await Users.VerifyTwoFactorTokenAsync(_user, Users.Options.Tokens.AuthenticatorTokenProvider, code))
        {
            _errors = ["The code is not correct. Check that the app shows the account just added, and use the current code."];
            return;
        }

        await Users.SetTwoFactorEnabledAsync(_user, true);
        _newCodes = [.. (await Users.GenerateNewTwoFactorRecoveryCodesAsync(_user, AdminIdentity.RecoveryCodeCount))!];
        _codesTitle = "Two-factor sign-in is on.";
        await Audit.RecordAsync(AuditCategory.Security, AuditActions.TwoFactorEnabled, AdminActor.From(HttpContext), "Two-factor sign-in turned on; new recovery codes made.");
        await SignIn.RefreshSignInAsync(_user);
        await LoadAsync();
    }

    private async Task NewRecoveryCodesAsync()
    {
        if (!await Users.CheckPasswordAsync(_user, Codes!.Password))
        {
            _errors = ["The password is not correct."];
            return;
        }

        _newCodes = [.. (await Users.GenerateNewTwoFactorRecoveryCodesAsync(_user, AdminIdentity.RecoveryCodeCount))!];
        _codesTitle = "New recovery codes made; the old ones no longer work.";
        await Audit.RecordAsync(AuditCategory.Security, AuditActions.RecoveryCodesGenerated, AdminActor.From(HttpContext), "New recovery codes made; the old ones no longer work.");
        await LoadAsync();
    }

    private async Task DisableAsync()
    {
        if (RemoteAdminRequest.IsRemote(HttpContext))
        {
            _errors = ["Two-factor sign-in cannot be turned off over remote access, which requires it. Use the gateway's own machine."];
            return;
        }

        if (!await Users.CheckPasswordAsync(_user, Disable!.Password))
        {
            _errors = ["The password is not correct."];
            return;
        }

        await Users.SetTwoFactorEnabledAsync(_user, false);
        await Users.ResetAuthenticatorKeyAsync(_user); // a new setup gets a new key
        await Users.GenerateNewTwoFactorRecoveryCodesAsync(_user, 0); // the old recovery codes stop working
        await SignIn.RefreshSignInAsync(_user);
        await Audit.RecordAsync(AuditCategory.Security, AuditActions.TwoFactorDisabled, AdminActor.From(HttpContext), "Two-factor sign-in turned off.");
        Navigation.NavigateTo("account?twoFactorOff=true");
    }
}
