@page "/account"
@inject UserManager<IdentityUser> Users
@inject SignInManager<IdentityUser> SignIn
@inject SignInHistory History
@inject AuditLogStore Audit
@inject NavigationManager Navigation

<PageTitle>Your account · @ProductInfo.Name</PageTitle>

<h1>Your account</h1>

<p>Signed in as <strong>@_userName</strong>.</p>

@if (Changed)
{
    <div class="alert alert-ok" role="status">Your password was changed. Other sessions were signed out.</div>
}

@if (TwoFactorOff)
{
    <div class="alert alert-ok" role="status">Two-factor sign-in is off.</div>
}

@if (SessionsEnded)
{
    <div class="alert alert-ok" role="status">All other sessions were signed out.</div>
}

@if (_errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <strong>The password was not changed.</strong>
        <ul>
            @foreach (var error in _errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<section class="cards" aria-label="Sign-in security">
    <div class="card">
        <h2>Two-factor sign-in</h2>
        @if (_twoFactor)
        {
            <p class="metric">On</p>
            <p class="muted">@_recoveryCodesLeft recovery codes left</p>
        }
        else
        {
            <p class="metric">Off</p>
            <p class="muted">Recommended; required for remote access.</p>
        }
        <p><a href="account/two-factor">@(_twoFactor ? "Manage" : "Turn on")</a></p>
    </div>
    <div class="card">
        <h2>Previous sign-in</h2>
        @if (_summary?.PreviousSignIn is { } previous)
        {
            <p class="metric">@DateTimeOffset.FromUnixTimeMilliseconds(previous.TimestampMs).UtcDateTime.ToString("yyyy-MM-dd HH:mm", Culture) UTC</p>
            <p class="muted">from @previous.ClientIp</p>
        }
        else
        {
            <p class="metric">None</p>
            <p class="muted">This is the first sign-in.</p>
        }
        <p class="@(_summary?.FailedSince > 0 ? "field-error" : "muted")">
            @(_summary?.FailedSince ?? 0) failed attempt@(_summary?.FailedSince == 1 ? "" : "s") since then
        </p>
        <p><a href="account/history">Login history</a></p>
    </div>
    <div class="card">
        <h2>Sessions</h2>
        <p class="muted">A session ends after @AdminIdentity.IdleTimeout.TotalMinutes minutes without activity, and @AdminIdentity.MaxSessionLifetime.TotalHours hours after signing in.</p>
        <form method="post" @formname="end-sessions" @onsubmit="EndOtherSessionsAsync" data-enhance>
            <AntiforgeryToken />
            <button type="submit" class="button button-secondary">Sign out other sessions</button>
        </form>
    </div>
</section>

<EditForm Model="Model" FormName="change-password" OnValidSubmit="ChangeAsync" Enhance class="form">
    <DataAnnotationsValidator />
    <fieldset>
        <legend>Change password</legend>
        <FormField Id="current-password" Label="Current password" For="() => Model!.CurrentPassword">
            <input id="current-password" type="password" name="Model.CurrentPassword" autocomplete="current-password" />
        </FormField>
        <FormField Id="new-password" Label="New password" Help="@AdminIdentity.PasswordHelp" For="() => Model!.NewPassword">
            <input id="new-password" type="password" name="Model.NewPassword" autocomplete="new-password" aria-describedby="new-password-help" />
        </FormField>
        <FormField Id="confirm-password" Label="New password again" For="() => Model!.ConfirmPassword">
            <input id="confirm-password" type="password" name="Model.ConfirmPassword" autocomplete="new-password" />
        </FormField>
    </fieldset>
    <div class="actions">
        <button type="submit" class="button">Change password</button>
    </div>
</EditForm>

@code {
    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.InvariantCulture;

    private string? _userName;
    private bool _twoFactor;
    private int _recoveryCodesLeft;
    private SignInSummary? _summary;
    private IReadOnlyList<string> _errors = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromQuery(Name = "changed")]
    public bool Changed { get; set; }

    [SupplyParameterFromQuery(Name = "twoFactorOff")]
    public bool TwoFactorOff { get; set; }

    [SupplyParameterFromQuery(Name = "sessionsEnded")]
    public bool SessionsEnded { get; set; }

    [SupplyParameterFromForm(FormName = "change-password")]
    private ChangePasswordFormModel? Model { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Model ??= new ChangePasswordFormModel();
        var user = await Users.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            Navigation.NavigateTo(AdminIdentity.LoginPath.TrimStart('/'));
            return;
        }

        _userName = user.UserName;
        _twoFactor = await Users.GetTwoFactorEnabledAsync(user);
        _recoveryCodesLeft = _twoFactor ? await Users.CountRecoveryCodesAsync(user) : 0;
        _summary = await History.SummaryAsync(user.Id);
    }

    private async Task ChangeAsync()
    {
        var user = await Users.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            Navigation.NavigateTo(AdminIdentity.LoginPath.TrimStart('/'));
            return;
        }

        var result = await Users.ChangePasswordAsync(user, Model!.CurrentPassword, Model.NewPassword);
        if (!result.Succeeded)
        {
            _errors = [.. result.Errors.Select(e => e.Code == "PasswordMismatch" ? "The current password is not correct." : e.Description)];
            return;
        }

        // A new security stamp: this session continues, other sessions end at their next request.
        await SignIn.RefreshSignInAsync(user);
        await Audit.RecordAsync(AuditCategory.Security, AuditActions.PasswordChanged, AdminActor.From(HttpContext), "Password changed; other sessions were signed out.");
        Navigation.NavigateTo("account?changed=true");
    }

    private async Task EndOtherSessionsAsync()
    {
        var user = await Users.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            Navigation.NavigateTo(AdminIdentity.LoginPath.TrimStart('/'));
            return;
        }

        await Users.UpdateSecurityStampAsync(user);
        await SignIn.RefreshSignInAsync(user);
        await History.RecordAsync(HttpContext, SignInOutcome.SessionsEnded, user);
        Navigation.NavigateTo("account?sessionsEnded=true");
    }
}
