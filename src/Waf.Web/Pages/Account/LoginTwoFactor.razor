@page "/account/login/two-factor"
@layout AccountLayout
@attribute [AllowAnonymous]
@inject AdminSignIn SignIn
@inject NavigationManager Navigation

<PageTitle>Two-factor sign-in · @ProductInfo.Name</PageTitle>

<h1>Two-factor sign-in</h1>

<p>Enter the 6-digit code that your authenticator app shows for @AdminIdentity.AuthenticatorIssuer.</p>

@if (_attempt is { Step: SignInStep.Failed })
{
    <div class="alert alert-danger" role="alert">The code is not correct. Codes change every 30 seconds; use the current one.</div>
}
else if (_attempt?.Message is { } message)
{
    <div class="alert alert-danger" role="alert">@message</div>
}

<EditForm Model="Model" FormName="two-factor" OnValidSubmit="VerifyAsync" Enhance class="form">
    <DataAnnotationsValidator />
    <input type="hidden" name="Model.ReturnUrl" value="@Model!.ReturnUrl" />
    <FormField Id="code" Label="Code" For="() => Model.Code">
        <input id="code" name="Model.Code" inputmode="numeric" autocomplete="one-time-code" maxlength="9" />
    </FormField>
    <div class="actions">
        <button type="submit" class="button">Sign in</button>
    </div>
</EditForm>

<p class="muted">
    No access to your authenticator app?
    <a href="@($"{AdminIdentity.LoginRecoveryPath.TrimStart('/')}?returnUrl={Uri.EscapeDataString(Model!.ReturnUrl ?? "/")}")">Use a recovery code</a>.
</p>

@code {
    private SignInAttempt? _attempt;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromForm(FormName = "two-factor")]
    private CodeFormModel? Model { get; set; }

    protected override void OnInitialized() => Model ??= new CodeFormModel { ReturnUrl = ReturnUrl };

    private async Task VerifyAsync()
    {
        var model = Model!;
        _attempt = await SignIn.CodeAsync(HttpContext, model.Code, recovery: false);
        if (_attempt.Step == SignInStep.SignedIn)
        {
            Navigation.NavigateTo(AdminIdentity.LocalReturnUrl(model.ReturnUrl));
        }
        else if (_attempt.Step == SignInStep.NoPendingSignIn)
        {
            Navigation.NavigateTo(AdminIdentity.LoginPath.TrimStart('/'));
        }
    }
}
