@page "/account/login/recovery"
@layout AccountLayout
@attribute [AllowAnonymous]
@inject AdminSignIn SignIn
@inject NavigationManager Navigation

<PageTitle>Sign in with a recovery code · @ProductInfo.Name</PageTitle>

<h1>Sign in with a recovery code</h1>

<p>Enter one of the recovery codes you saved when you turned on two-factor sign-in. Each code works once.</p>

@if (_attempt is { Step: SignInStep.Failed })
{
    <div class="alert alert-danger" role="alert">That recovery code is not correct, or was used before.</div>
}
else if (_attempt?.Message is { } message)
{
    <div class="alert alert-danger" role="alert">@message</div>
}

<EditForm Model="Model" FormName="recovery" OnValidSubmit="VerifyAsync" Enhance class="form">
    <DataAnnotationsValidator />
    <input type="hidden" name="Model.ReturnUrl" value="@Model!.ReturnUrl" />
    <FormField Id="recovery-code" Label="Recovery code" For="() => Model.Code">
        <input id="recovery-code" name="Model.Code" autocomplete="off" />
    </FormField>
    <div class="actions">
        <button type="submit" class="button">Sign in</button>
    </div>
</EditForm>

<p class="muted">Afterwards, check how many codes you have left on your account page, and make new ones if needed.</p>

@code {
    private SignInAttempt? _attempt;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromForm(FormName = "recovery")]
    private CodeFormModel? Model { get; set; }

    protected override void OnInitialized() => Model ??= new CodeFormModel { ReturnUrl = ReturnUrl };

    private async Task VerifyAsync()
    {
        var model = Model!;
        _attempt = await SignIn.CodeAsync(HttpContext, model.Code, recovery: true);
        if (_attempt.Step == SignInStep.SignedIn)
        {
            Navigation.NavigateTo(AdminIdentity.LocalReturnUrl(model.ReturnUrl));
        }
        else if (_attempt.Step == SignInStep.NoPendingSignIn)
        {
            Navigation.NavigateTo(AdminIdentity.LoginPath.TrimStart('/'));
        }
    }
}
