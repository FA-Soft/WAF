@page "/"
@inject ITargetAddressMonitor Addresses
@inject IRouteFailoverMonitor Failover
@inject IBackendErrorStatistics BackendErrors
@inject WafEngineHolder Engines
@inject ConfigurationStore Store
@inject IRequestLogMonitor RequestLog
@inject IRequestMetricsMonitor Metrics

<PageTitle>@T("Dashboard") · @ProductInfo.Name</PageTitle>

<h1>@T("Dashboard")</h1>

<TwoFactorNotice />
<CertificateNotice />

@foreach (var lost in Addresses.Statuses.Where(s => !s.Available))
{
    <div class="alert alert-warning" role="status">
        @if (lost.LastSeen is { } seen)
        {
            @TM("<strong>Target '{0}' is not found</strong> (MAC address {1}, last seen {2}Z): its routes get no traffic until it is back.", lost.TargetName, lost.MacAddress, seen.UtcDateTime.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture))
        }
        else
        {
            @TM("<strong>Target '{0}' is not found</strong> (MAC address {1}): its routes get no traffic until it is back.", lost.TargetName, lost.MacAddress)
        }
        <a href="targets">@T("Targets")</a>
    </div>
}

@foreach (var failover in Failover.Statuses)
{
    <div class="alert alert-warning" role="status">
        @TM("<strong>Route '{0}' is on failover {1}</strong> since {2}: no primary backend is healthy, so its traffic goes to {3}. It returns once a primary is healthy again.", failover.RouteName, failover.Failover, Describe.Time(failover.Since), failover.Destinations) <a href="routes">@T("Routes")</a>
    </div>
}

@if (Engines.Current is null)
{
    <div class="alert alert-danger" role="alert">
        <strong>@T("The firewall is not running: public traffic is refused (503).")</strong>
        <p>@Engines.UnavailableReason</p>
    </div>
}
else if (Engines.Current.DetectionOnly)
{
    <div class="alert alert-warning" role="status">
        <strong>@T("Detection only.")</strong> @T("Requests that would be blocked are logged but let through.")
        <HelpTip Title="@T("Detection only")">
            <p>@T("Use this mode to try out rules without risk. Switch it off in the settings once the logs show no unwanted blocks.")</p>
        </HelpTip>
    </div>
}

<TrafficAlertNotice />

<AppSettingsNoticeBanner />

@if (_active is null)
{
    <p>@T("No configuration has been activated yet.")</p>
}
else
{
    var configuration = _active.Configuration;
    var detections = Describe.EnabledDetections(configuration.Settings.AttackDetection);

    <section class="cards" aria-label="@T("Summary")">
        <div class="card live-traffic" id="live-traffic" data-hub="hubs/traffic"
             data-text-connecting="@T("Connecting…")" data-text-live="@T("Live, updated every second")"
             data-text-reconnecting="@T("Reconnecting…")" data-text-ended="@T("Your session ended. Reload the page to sign in again.")">
            <h2>
                @T("Requests per second")
                <HelpTip Title="@T("Requests per second")"><p>@T("Public requests completed in the last second, pushed by the gateway every second while this page is open. Good: forwarded, redirected or answered. Bad: blocked, rate limited, refused (fail-closed) or without a route. Failed: no backend answered. The addresses are the sources of the most bad requests in the last minute.")</p></HelpTip>
            </h2>
            <p class="metric" data-live="total">–</p>
            <p class="muted">
                @T("Good") <strong data-live="good">–</strong> ·
                @T("Bad") <strong data-live="bad">–</strong> ·
                @T("Failed") <strong data-live="failed">–</strong>
            </p>
            <ol class="live-sources" data-live="sources" aria-label="@T("Sources of bad requests, last minute")"></ol>
            <p class="muted" data-live="no-sources" hidden>@T("No bad requests in the last minute.")</p>
            <p class="muted live-status" data-live="status" role="status" data-state="off">@T("Needs JavaScript to update.")</p>
            <a href="performance">@T("Performance and history")</a>
        </div>
        <div class="card">
            <h2>@T("Configuration")</h2>
            <p class="metric">@T("Version {0}", _active.Version)</p>
            <p class="muted">
                @T("Activated {0} by {1}", _active.CreatedAtUtc.ToString("u", System.Globalization.CultureInfo.InvariantCulture), Message(_active.Author))
            </p>
            @if (!string.IsNullOrEmpty(_active.Comment))
            {
                <p>@Message(_active.Comment)</p>
            }
            <a href="history">@T("View history")</a>
        </div>
        <div class="card">
            <h2>
                @T("Routes")
                <HelpTip Title="@T("Routes")"><p>@T("A route decides which backend receives a request, based on host name, path and method. Requests that match no route get 404.")</p></HelpTip>
            </h2>
            <p class="metric">@configuration.Routes.Count</p>
        </div>
        <div class="card">
            <h2>
                @T("Rules")
                <HelpTip Title="@T("Rules")"><p>@T("Rules allow or block requests, for example by IP address or path. They run in priority order; the first Allow or Block decides.")</p></HelpTip>
            </h2>
            <p class="metric">@configuration.Rules.Count(r => r.Enabled)</p>
            <p class="muted">@T("{0} disabled", configuration.Rules.Count(r => !r.Enabled))</p>
        </div>
        <div class="card">
            <h2>
                @T("Attack detection")
                <HelpTip Title="@T("Attack detection")"><p>@T("Built-in checks for common attacks in the path, query string, headers and (optionally) the body.")</p></HelpTip>
            </h2>
            <p class="metric">@(detections.Count == 0 ? Text.T("Off") : Text.T("{0} of 5", detections.Count))</p>
            <p class="muted">@string.Join(", ", detections)</p>
        </div>
        <div class="card">
            <h2>
                @T("Request log")
                <HelpTip Title="@T("Request log")"><p>@T("Every public request is recorded in events.db, in the background. If the disk cannot keep up, entries are dropped rather than slowing down requests; the count shows here.")</p></HelpTip>
            </h2>
            @if (RequestLog.Statistics is { } log)
            {
                <p class="metric">@log.Written.ToString("N0", CultureInfo.CurrentCulture)</p>
                <p class="muted">@(log.Queued > 0 ? T("written since start, {0} waiting", log.Queued.ToString("N0", CultureInfo.CurrentCulture)) : T("written since start"))</p>
                @if (log.Dropped > 0)
                {
                    <p><span class="badge badge-warning">@log.Dropped.ToString("N0", CultureInfo.CurrentCulture) dropped</span></p>
                }
                @if (log.LastError is not null)
                {
                    <p class="field-error">@T("Writing fails: {0}", log.LastError)</p>
                }
                <p>@TM("<a href=\"logs\">View the log</a> · <a href=\"logs/settings\">Retention</a>")</p>
            }
            else
            {
                <p class="metric">@T("Off")</p>
                <p class="muted">@T("Switched off in the host settings (Gateway:EventLog:Enabled).")</p>
            }
        </div>
        <div class="card">
            <h2>
                @T("Traffic counts")
                <HelpTip Title="@T("Traffic counts")"><p>@T("Every public request is counted per second (good, bad or failed) and stored in metrics.db every few seconds, for the performance dashboard. If storing cannot keep up, counts are dropped rather than slowing down requests; the number shows here.")</p></HelpTip>
            </h2>
            @if (Metrics.Statistics is { } counts)
            {
                <p class="metric">@counts.Counted.ToString("N0", CultureInfo.CurrentCulture)</p>
                <p class="muted">@T("requests counted since start")</p>
                @if (counts.Dropped > 0)
                {
                    <p><span class="badge badge-warning">@T("{0} not counted", counts.Dropped.ToString("N0", CultureInfo.CurrentCulture))</span></p>
                }
                @if (counts.LastError is not null)
                {
                    <p class="field-error">@T("Writing fails: {0}", counts.LastError)</p>
                }
            }
            else
            {
                <p class="metric">@T("Off")</p>
                <p class="muted">@T("Switched off in the host settings (Gateway:Metrics:Enabled).")</p>
            }
        </div>
    </section>

    <section aria-labelledby="routes-heading">
        <h2 id="routes-heading">@T("Routes") <a class="heading-link" href="routes">@T("Manage routes")</a></h2>
        @if (configuration.Routes.Count == 0)
        {
            <p>@T("No routes yet: every public request gets 404.")</p>
        }
        else
        {
            <table>
                <thead><tr><th scope="col">@T("Name")</th><th scope="col">@T("Handles")</th><th scope="col">@T("Forwards to")</th></tr></thead>
                <tbody>
                    @foreach (var route in configuration.Routes)
                    {
                        <tr>
                            <td>@route.Name</td>
                            <td>@Describe.Match(route.Match)</td>
                            <td>@Describe.Destinations(route.Destinations, configuration.Targets, Addresses)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    @if (BackendErrors.Routes is { Count: > 0 } errors)
    {
        <section aria-labelledby="backend-errors-heading">
            <h2 id="backend-errors-heading">
                @T("Backend errors since the start")
                <HelpTip Title="@T("Backend errors")">
                    <p>@TM("Requests that got an error because no backend answered: <strong>no backend</strong> (503, none was healthy), <strong>backend error</strong> (502, the connection failed or the answer was invalid) and <strong>time-out</strong> (504). The request log has each request, with the backend that was tried.")</p>
                </HelpTip>
                <a class="heading-link" href="logs?show=Errors">@T("View in the request log")</a>
            </h2>
            <table>
                <thead><tr><th scope="col">@T("Route")</th><th scope="col">@T("No backend (503)")</th><th scope="col">@T("Backend error (502)")</th><th scope="col">@T("Time-out (504)")</th><th scope="col">@T("Last")</th></tr></thead>
                <tbody>
                    @foreach (var route in errors)
                    {
                        <tr>
                            <td>@route.RouteName</td>
                            <td>@route.NoBackend.ToString("N0", CultureInfo.CurrentCulture)</td>
                            <td>@route.BackendError.ToString("N0", CultureInfo.CurrentCulture)</td>
                            <td>@route.Timeout.ToString("N0", CultureInfo.CurrentCulture)</td>
                            <td>@Describe.Time(route.Last)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    <section aria-labelledby="rules-heading">
        <h2 id="rules-heading">@T("Rules") <a class="heading-link" href="rules">@T("Manage rules")</a></h2>
        @if (configuration.Rules.Count == 0)
        {
            <p>@T("No rules yet. Attack detection and rate limits still apply.")</p>
        }
        else
        {
            <table>
                <thead><tr><th scope="col">@T("Priority")</th><th scope="col">@T("Name")</th><th scope="col">@T("When")</th><th scope="col">@T("Then")</th></tr></thead>
                <tbody>
                    @foreach (var rule in configuration.Rules.OrderBy(r => r.Priority).ThenBy(r => r.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <tr class="@(rule.Enabled ? null : "disabled")">
                            <td>@rule.Priority</td>
                            <td>@rule.Name @(rule.Enabled ? null : "(disabled)")</td>
                            <td>@Describe.Conditions(rule.Conditions)</td>
                            <td>@Describe.Action(rule, configuration.Settings.DetectionOnly)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    @if (configuration.RateLimits.Count > 0)
    {
        <section aria-labelledby="limits-heading">
            <h2 id="limits-heading">@T("Rate limits") <a class="heading-link" href="rate-limits">@T("Manage rate limits")</a></h2>
            <ul>
                @foreach (var limit in configuration.RateLimits.Where(l => l.Enabled))
                {
                    <li><strong>@limit.Name</strong>: @Describe.RateLimit(limit)</li>
                }
            </ul>
        </section>
    }
}

@code {
    private StoredConfiguration? _active;

    protected override async Task OnInitializedAsync() =>
        _active = await Store.GetLastKnownGoodAsync(CancellationToken.None);
}
