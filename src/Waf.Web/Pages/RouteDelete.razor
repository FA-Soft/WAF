@page "/routes/{RouteName}/delete"
@inject ITargetAddressMonitor Addresses
@inject IGatewayConfigurationService Configurations
@inject NavigationManager Navigation

<PageTitle>@T("Delete route {0}", RouteName) · @ProductInfo.Name</PageTitle>

<p><a href="routes">← @T("Routes")</a></p>
<h1>@T("Delete route '{0}'?", RouteName)</h1>

@if (_route is null)
{
    <div class="alert alert-danger" role="alert">@T("Route '{0}' does not exist (any more).", RouteName) <a href="routes">@T("Back to the routes")</a>.</div>
}
else
{
    <dl class="details">
        <dt>@T("Handles")</dt><dd>@Describe.Match(_route.Match)</dd>
        <dt>@T("Forwards to")</dt><dd>@Describe.Destinations(_route.Destinations, _targets, Addresses)</dd>
    </dl>

    @if (_references.Count > 0)
    {
        <div class="alert alert-warning" role="alert">
            @TM("<strong>This route cannot be deleted yet</strong>, because it is used by:")
            <ul>
                @foreach (var reference in _references)
                {
                    <li>@reference</li>
                }
            </ul>
            <p>@T("Remove the route from these first, or disable the route instead.")</p>
        </div>
    }
    else
    {
        @if (_errors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                <strong>@T("The route was not deleted.")</strong>
                <ul>
                    @foreach (var error in _errors)
                    {
                        <li>@Message(error)</li>
                    }
                </ul>
            </div>
        }

        <p>@T("Requests it handles will get 404 (or go to another matching route). The deletion is stored as a new configuration version, so it can be undone by restoring the previous version.")</p>
        <form method="post" @formname="route-delete" @onsubmit="DeleteAsync" data-enhance class="actions">
            <AntiforgeryToken />
            <input type="hidden" name="BaseVersion" value="@_baseVersion" />
            <button type="submit" class="button button-danger">@T("Delete route")</button>
            <a class="button button-secondary" href="routes">@T("Cancel")</a>
        </form>
    }
}

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private ProxyRouteOptions? _route;
    private IReadOnlyList<BackendTarget> _targets = [];
    private IReadOnlyList<string> _references = [];
    private IReadOnlyList<string> _errors = [];
    private long _baseVersion;

    [Parameter]
    public string RouteName { get; set; } = string.Empty;

    [SupplyParameterFromForm(FormName = "route-delete")]
    private long? BaseVersion { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var active = await Configurations.GetActiveAsync(CancellationToken.None);
        _baseVersion = active?.Version ?? 0;
        _route = active?.Configuration.Routes.FirstOrDefault(r => string.Equals(r.Name, RouteName, StringComparison.OrdinalIgnoreCase));
        _targets = [.. active?.Configuration.Targets ?? []];
        _references = active is null || _route is null ? [] : ConfigurationEditing.RouteReferences(active.Configuration, _route.Name);
    }

    private async Task DeleteAsync()
    {
        var active = await Configurations.GetActiveAsync(CancellationToken.None);
        var configuration = ConfigurationEditing.Clone(active!.Configuration);
        var route = configuration.Routes.FirstOrDefault(r => string.Equals(r.Name, RouteName, StringComparison.OrdinalIgnoreCase));
        if (route is null)
        {
            _errors = [Text.F("Route '{0}' no longer exists.", RouteName)];
            return;
        }

        configuration.Routes.Remove(route);
        var result = await Configurations.ActivateIfCurrentAsync(BaseVersion ?? active.Version, configuration, AdminActor.From(HttpContext), $"Route '{route.Name}' deleted.", CancellationToken.None);
        if (!result.Succeeded)
        {
            _errors = result.Errors;
            return;
        }

        Navigation.NavigateTo($"routes?saved={Uri.EscapeDataString($"Route '{route.Name}' deleted (version {result.Version!.Version}).")}");
    }
}
