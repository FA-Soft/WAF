@page "/presets/{PresetId}"
@inject IGatewayConfigurationService Configurations
@inject NavigationManager Navigation

<PageTitle>@T(_preset?.Title ?? "Preset") · @ProductInfo.Name</PageTitle>

<p><a href="library">← @T("Templates and presets")</a></p>

@if (_preset is null)
{
    <h1>@T("Preset not found")</h1>
    <div class="alert alert-danger" role="alert">@T("There is no preset '{0}'.", PresetId ?? string.Empty) <a href="library">@T("See the available presets")</a>.</div>
}
else if (_active is null)
{
    <h1>@T(_preset.Title)</h1>
    <div class="alert alert-danger" role="alert">@T("No configuration is active yet, so there is nothing to apply the preset to.")</div>
}
else if (Model is not null)
{
    <h1>@T(_preset.Title)</h1>
    <p>@T(_preset.Details)</p>

    @if (_errors.Count > 0)
    {
        <div class="alert alert-danger" role="alert">
            <strong>@T("The preset was not applied.")</strong> @T("The running configuration is unchanged.")
            <ul>
                @foreach (var error in _errors)
                {
                    <li>@Message(error)</li>
                }
            </ul>
        </div>
    }

    @if (_notice is not null)
    {
        <div class="alert alert-warning" role="alert">@Message(_notice)</div>
    }

    <EditForm Model="Model" FormName="preset-apply" OnSubmit="HandleAsync" Enhance class="form">
        <input type="hidden" name="Model.PreviewTag" value="@_preview?.Tag" />

        @if (_preset.Inputs != PresetInputs.None)
        {
            <fieldset>
                <legend>@T("Settings")</legend>

                @if (_preset.Asks(PresetInputs.PathPrefix))
                {
                    <FormField Id="path" Label="@T("Path")" Help="@PathHelp" For="() => Model.PathPrefix">
                        <InputText id="path" aria-describedby="path-help" @bind-Value="Model.PathPrefix" autocomplete="off" />
                    </FormField>
                }

                @if (_preset.Asks(PresetInputs.AllowedIps))
                {
                    <FormField Id="ips" Label="@T("Your IP addresses")" Help="@T("One per line, e.g. 203.0.113.7 or a range such as 203.0.113.0/24 or 2001:db8::/48. Only these may open the path.")" For="() => Model.AllowedIps">
                        <InputTextArea id="ips" aria-describedby="ips-help" @bind-Value="Model.AllowedIps" rows="4" />
                    </FormField>
                }

                @if (_preset.Asks(PresetInputs.PermitLimit))
                {
                    <FormField Id="limit" Label="@T("Requests per minute")" Help="@T("Per client IP. Clients that send more get 429 until they slow down.")" For="() => Model.PermitLimit">
                        <InputNumber id="limit" aria-describedby="limit-help" @bind-Value="Model.PermitLimit" min="1" />
                    </FormField>
                }

                @if (_preset.Asks(PresetInputs.DetectionOnly))
                {
                    <div class="field checkbox-field">
                        <InputCheckbox id="detection-only" @bind-Value="Model.DetectionOnly" aria-describedby="detection-only-help" />
                        <label for="detection-only">@T("Only log at first")</label>
                        <p class="field-help" id="detection-only-help">@T("Try it without risk: matches are logged as \"would block\" and the requests continue. Switch it off later in the editor.")</p>
                    </div>
                }

                @if (_preset.Asks(PresetInputs.Routes))
                {
                    <RouteScopeEditor Prefix="Model" Choices="Model.RouteChoices" />
                }

                <button type="submit" name="Model.Command" value="preview" class="button button-secondary">@T("Update preview")</button>
            </fieldset>
        }

        <section class="preview" aria-labelledby="preview-heading" aria-live="polite">
            <h2 id="preview-heading">@T("Preview: what will change")</h2>

            @if (_preview is null || _preview.InputProblems.Count > 0)
            {
                <div class="alert alert-warning" role="status">
                    <strong>@T("Complete the settings above, then press \"Update preview\".")</strong>
                    @if (_preview is not null)
                    {
                        <ul>
                            @foreach (var problem in _preview.InputProblems)
                            {
                                <li>@problem</li>
                            }
                        </ul>
                    }
                </div>
            }
            else if (_preview.Changes.Count == 0)
            {
                <div class="alert alert-ok" role="status">@T("Nothing to change: this preset is already in place.")</div>
            }
            else
            {
                <ChangeList Changes="_preview.Changes" Before="_active.Configuration" After="_preview.Candidate!" />

                @if (_preview.ValidationErrors.Count > 0)
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>@T("This preset cannot be applied to the current configuration:")</strong>
                        <ul>
                            @foreach (var error in _preview.ValidationErrors)
                            {
                                <li>@Message(error)</li>
                            }
                        </ul>
                    </div>
                }
                else
                {
                    <p class="muted">@TM("Applying creates version {0} and takes effect immediately, without a restart. You can roll it back on the <a href=\"history\">history page</a>.", _active.Version + 1)</p>
                }
            }
        </section>

        <div class="actions">
            @if (_preview?.CanApply == true)
            {
                <button type="submit" name="Model.Command" value="apply" class="button">@T("Apply these changes")</button>
            }
            <a class="button button-secondary" href="library">@T("Cancel")</a>
        </div>
    </EditForm>
}

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    public const string ApplyCommand = "apply";

    private Preset? _preset;
    private StoredConfiguration? _active;
    private PresetPreview? _preview;
    private IReadOnlyList<string> _errors = [];
    private string? _notice;

    [Parameter]
    public string? PresetId { get; set; }

    [SupplyParameterFromForm(FormName = "preset-apply")]
    private PresetFormModel? Model { get; set; }

    private string PathHelp => _preset?.Id == "protect-login"
        ? Text.T("Where the login form posts to, e.g. /login or /account/signin. Paths below it count too.")
        : Text.T("The path to protect, e.g. /admin. Paths below it are protected too.");

    protected override async Task OnInitializedAsync()
    {
        _preset = Presets.Find(PresetId);
        _active = await Configurations.GetActiveAsync(CancellationToken.None);
        if (_preset is null || _active is null || Model is not null)
        {
            return; // a posted form is handled in HandleAsync
        }

        Model = Presets.NewModel(_preset, _active.Configuration.Routes.Select(r => r.Name));
        _preview = Presets.Preview(_preset, Model, _active.Configuration);
    }

    private async Task HandleAsync()
    {
        var model = Model!;
        var preset = _preset!;
        var active = _active!;

        // Offer the routes that exist now, keeping the ticks that were posted (a deleted route simply disappears).
        var ticked = new HashSet<string>(model.SelectedRoutes, StringComparer.OrdinalIgnoreCase);
        model.RouteChoices = [.. active.Configuration.Routes.Select(r => new RouteChoice { Name = r.Name, Selected = ticked.Contains(r.Name) })];

        _preview = Presets.Preview(preset, model, active.Configuration);

        if (model.Command == ApplyCommand && _preview.CanApply)
        {
            if (_preview.Tag != model.PreviewTag)
            {
                // The settings were edited after the preview, or someone else changed the configuration: never
                // save something the user has not seen.
                _notice = Text.N("The settings or the running configuration changed since the preview. Check the updated preview below, then apply again.");
            }
            else
            {
                var result = await Configurations.ActivateIfCurrentAsync(
                    active.Version, _preview.Candidate!, AdminActor.From(HttpContext), $"Preset '{preset.Title}' applied.", CancellationToken.None);
                if (result.Succeeded)
                {
                    Navigation.NavigateTo($"library?saved={Uri.EscapeDataString($"Preset '{preset.Title}' applied (version {result.Version!.Version}).")}");
                    return;
                }

                _errors = result.Errors;
                _active = await Configurations.GetActiveAsync(CancellationToken.None);
                _preview = Presets.Preview(preset, model, _active!.Configuration);
            }
        }

        model.Command = null;
    }
}
